#!/data/data/com.termux/files/usr/bin/python
"""Pinned local TLS transport; stdout is exclusively for ssh-add."""
import datetime
import hashlib
import hmac
import os
import pathlib
import secrets
import socket
import ssl
import struct
import subprocess
import sys
import time

def identity():
    from cryptography import x509
    from cryptography.hazmat.primitives import hashes, serialization
    from cryptography.hazmat.primitives.asymmetric import ec
    from cryptography.x509.oid import NameOID
    root = pathlib.Path(os.environ.get("XDG_STATE_HOME",str(pathlib.Path.home()/".local/state")))/"termux-biometric-ssh"
    root.mkdir(mode=0o700,parents=True,exist_ok=True)
    keyfile, certfile = root/"transport-key.pem", root/"transport-cert.pem"
    if not keyfile.exists() and not certfile.exists():
        key = ec.generate_private_key(ec.SECP256R1())
        name = x509.Name([x509.NameAttribute(NameOID.COMMON_NAME,"Local Termux SSH")])
        now = datetime.datetime.now(datetime.timezone.utc)
        cert = (x509.CertificateBuilder().subject_name(name).issuer_name(name)
                .public_key(key.public_key()).serial_number(x509.random_serial_number())
                .not_valid_before(now-datetime.timedelta(minutes=5))
                .not_valid_after(now+datetime.timedelta(days=3650)).sign(key,hashes.SHA256()))
        for path,data in [(keyfile,key.private_bytes(serialization.Encoding.PEM,serialization.PrivateFormat.PKCS8,serialization.NoEncryption())),(certfile,cert.public_bytes(serialization.Encoding.PEM))]:
            with open(os.open(path,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600),"wb") as stream: stream.write(data)
    cert = x509.load_pem_x509_certificate(certfile.read_bytes())
    pin = cert.fingerprint(hashes.SHA256()).hex()
    ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
    ctx.minimum_version = ssl.TLSVersion.TLSv1_2
    ctx.load_cert_chain(certfile,keyfile)
    return ctx,pin

def receive_exact(conn,count):
    data=bytearray()
    while len(data)<count:
        try: part=conn.recv(count-len(data))
        except OSError as exc: raise RuntimeError("连接中断：指纹认证取消或应用报错") from exc
        if not part: raise RuntimeError("连接关闭：指纹认证取消或应用报错")
        data.extend(part)
    return data

def main():
    if len(sys.argv)>1 and sys.argv[1].startswith("Bad passphrase"):
        raise RuntimeError("保存的口令与此 SSH 私钥不匹配。请在应用中更新口令，或用普通 ssh-add 加载使用其他口令的密钥。")
    ctx,pin=identity()
    token=secrets.token_hex(24)
    print("Termux 本机证书 SHA-256（首次连接请核对）：\n"+pin,file=sys.stderr,flush=True)
    with socket.socket(socket.AF_INET,socket.SOCK_STREAM) as server:
        server.bind(("127.0.0.1",0)); server.listen(4); server.settimeout(90)
        port=server.getsockname()[1]
        result=subprocess.run([os.path.join(os.environ.get("PREFIX","/data/data/com.termux/files/usr"),"bin/am"),
            "start","--user",str(os.getuid()//100000),"-n","local.termux.biometricssh/.MainActivity",
            "--es","token",token,"--es","pin",pin,"--ei","port",str(port)],
            stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=15)
        if result.returncode or any(x in result.stdout+result.stderr for x in (b"Error",b"Exception")):
            raise RuntimeError("无法打开“SSH 指纹解锁”。请先安装 ./init ssh-biometric 生成的 APK，再打开应用保存口令。")
        deadline=time.monotonic()+90
        while time.monotonic()<deadline:
            server.settimeout(max(.1,deadline-time.monotonic()))
            raw,_=server.accept(); raw.settimeout(min(3,max(.1,deadline-time.monotonic())))
            conn=None
            try:
                conn=ctx.wrap_socket(raw,server_side=True)
                if not hmac.compare_digest(receive_exact(conn,48),token.encode()):
                    conn.close(); continue
            except (OSError,RuntimeError):
                if conn is not None: conn.close()
                raw.close(); continue
            with conn:
                conn.settimeout(max(.1,deadline-time.monotonic()))
                size=struct.unpack(">I",receive_exact(conn,4))[0]
                if size==0:
                    length=struct.unpack(">I",receive_exact(conn,4))[0]
                    if not 0<length<=1024: raise RuntimeError("应用返回了无效错误长度")
                    error=receive_exact(conn,length).decode("utf-8",errors="replace")
                    conn.sendall(b"\x01")
                    raise RuntimeError("Android 应用："+''.join(c for c in error if c.isprintable()))
                if not 0<size<=65536: raise RuntimeError("无效口令长度")
                plain=receive_exact(conn,size)
                try:
                    conn.sendall(b"\x01")
                    sys.stdout.buffer.write(plain); sys.stdout.buffer.write(b"\n"); sys.stdout.buffer.flush()
                finally: plain[:]=b"\0"*len(plain)
                return
        raise TimeoutError("等待指纹认证超时")

if __name__=="__main__":
    try: main()
    except Exception as exc:
        print("SSH 指纹解锁失败："+str(exc),file=sys.stderr); sys.exit(1)
