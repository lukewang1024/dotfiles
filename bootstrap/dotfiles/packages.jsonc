    ],
    "casks": [
      [
        "android-platform-tools",  // Android SDK component
        "dotnet-sdk",              // Developer platform
        "gcloud-cli",              // Set of tools to manage resources and applications hosted on Google Cloud
        "miniconda",               // Minimal installer for conda
