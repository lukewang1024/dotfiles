#!/usr/bin/env bash

realpath() {
  local filename=$1
  local parent_dir=$(dirname "${filename}")

  if [ -d "${filename}" ]; then
    echo "$(cd "${filename}" && pwd)"
  elif [ -d "${parent_dir}" ]; then
    echo "$(cd "${parent_dir}" && pwd)/$(basename "${filename}")"
  fi
}

repo_path=$(dirname `realpath $0`)
partial_dir="$repo_path/bootstrap"
config_dir="$repo_path/config"
util_dir="$repo_path/util"
bin_dir="$HOME/.local/bin"

source "$partial_dir/util.sh"

detect_platform() {
  if [ -n "${TERMUX_VERSION:-}" ] || [ "${PREFIX:-}" = '/data/data/com.termux/files/usr' ]; then
    echo termux
    return
  fi

  case $(uname -s 2>/dev/null) in
    Darwin) echo macos ;;
    CYGWIN*|MINGW*|MSYS*) echo cygwin ;;
    Linux)
      if [ -f /etc/arch-release ]; then
        echo arch
      elif [ -f /etc/lsb-release ] && grep -q '^CHROMEOS_RELEASE_' /etc/lsb-release; then
        echo chromeos
      elif [ -f /etc/debian_version ]; then
        echo debian
      else
        echo unknown
      fi
      ;;
    *) echo unknown ;;
  esac
}

mode=${1:-}
[ -n "$mode" ] || print_usage 2

case "$mode" in
  basic|core|all|sync|npmg|zinit|kerberos|migrate-xdg|run) ;;
  *)
    echo "Unknown mode or task: $mode" >&2
    print_usage 2
    ;;
esac

platform=$(detect_platform)
if [ "$platform" = unknown ]; then
  echo 'Could not detect this platform.' >&2
  print_usage 2
fi
export DOTFILES_PLATFORM="$platform"

case "$mode" in
  'basic')
    source "$partial_dir/env.sh"
    if [ "$platform" = termux ]; then
      source "$partial_dir/termux.sh"
      termux_basic_setup
    else
      basic_env_setup
    fi
    ;;

  'core' | 'all')
    case "$platform" in
      macos)
        source "$partial_dir/macos.sh"
        prepare_macos_env "$mode"
        ;;
      debian)
        source "$partial_dir/debian.sh"
        prepare_debian_env "$mode"
        ;;
      arch)
        source "$partial_dir/arch.sh"
        prepare_arch_env "$mode"
        ;;
      chromeos)
        [ "$mode" = core ] || echo 'Warning: ChromeOS has no additional all package set; using core.' >&2
        source "$partial_dir/chromeos.sh"
        prepare_chromeos
        ;;
      termux)
        source "$partial_dir/env.sh"
        source "$partial_dir/termux.sh"
        prepare_termux_env "$mode"
        ;;
      cygwin)
        [ "$mode" = core ] || echo 'Warning: Cygwin has no additional all package set; using core.' >&2
        source "$partial_dir/cygwin.sh"
        check_admin
        setup_cygwin_env
        install_sage
        install_cygwin_packages
        ;;
    esac
    ;;

  'npmg')
    source "$partial_dir/pkg.sh"
    install_npm_packages
    ;;

  'zinit')
    source "$partial_dir/shell.sh"
    zinit_setup
    ;;

  'kerberos')
    shift
    exec "$partial_dir/kerberos.sh" "$@"
    ;;

  'sync')
    source "$partial_dir/env.sh"
    sync_setup
    ;;

  'migrate-xdg')
    shift
    exec "$util_dir/dotfiles/migrate-xdg" "$@"
    ;;

  'run')
    echo "Run '$3' in '$partial_dir/$2.sh'..."
    echo
    source "$partial_dir/$2.sh"
    eval "$3"
    run_status=$?
    if [ "$run_status" -ne 0 ]; then
      echo "Task '$3' failed with status $run_status." >&2
      exit "$run_status"
    fi
    ;;

  *)
    print_usage
    ;;
esac

echo 'All jobs done. Have a nice day...'
exit 0
