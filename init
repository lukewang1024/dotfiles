#!/bin/sh
# Route native interactive commands, otherwise bootstrap the shared Python entrypoint.
set -eu
repo_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
# These interactive recovery tools must also work before Python is available.
# Delegate all provisioning/authentication to the helpers; keep this a router.
case ${1:-} in
  sshd) shift; exec sh "$repo_dir/util/shell/ssh-setup" "$@" ;;
  pair) shift; exec sh "$repo_dir/util/shell/ssh-pair" "$@" ;;
esac
main_script=$repo_dir/bootstrap/main.py
[ -f "$main_script" ] || { printf '%s\n' "Missing $main_script; run init from a complete dotfiles checkout." >&2; exit 1; }
export PYTHONDONTWRITEBYTECODE=1
bootstrap_system=$(uname -s)
bootstrap_ish=no
case "$(uname -r)" in
  *-ish*)
    bootstrap_ish=yes
    # An isolated, verified runtime can recover iSH builds whose system Python
    # prints its version but hangs during interpreter initialization.
    if [ -x "${XDG_DATA_HOME:-$HOME/.local/share}/dotfiles/ish-python/usr/bin/python3.12" ]; then
      exec sh "$repo_dir/util/ish/python3" "$main_script" "$@"
    fi
    ;;
esac
runtime_supported() {
  if [ "$bootstrap_ish" = yes ] && command -v timeout >/dev/null 2>&1; then
    timeout 10 "$1" -c 'import sys; sys.exit(sys.version_info < (3, 10))'
  else
    "$1" -c 'import sys; sys.exit(sys.version_info < (3, 10))'
  fi
}
for runtime in python3 python "$HOME/.local/bin/python3" "$HOME/.local/bin/python3.12" /opt/homebrew/bin/python3 /usr/local/bin/python3; do
  if command -v "$runtime" >/dev/null 2>&1 &&
     runtime_supported "$runtime" >/dev/null 2>&1; then
    case $bootstrap_system in
      CYGWIN*) "$runtime" -c 'import sys; sys.exit(not sys.platform.startswith("cygwin"))' >/dev/null 2>&1 || continue ;;
    esac
    exec "$runtime" "$main_script" "$@"
  fi
done
case $bootstrap_system in
  CYGWIN*) printf '%s\n' 'Install Cygwin-native Python 3.10+ using Cygwin Setup, then rerun init.' >&2; exit 1 ;;
esac
[ "$#" -gt 0 ] || { printf '%s\n' 'Usage: init <basic|core|all|sync|run|...> [options]' >&2; exit 2; }
# An inspection must not silently install a runtime.
for argument do
  case $argument in
    --dry-run|--list-tasks|-h|--help)
      printf '%s\n' 'Python 3.10+ is required to inspect this checkout. Run init core to prepare the bootstrap runtime.' >&2
      exit 1 ;;
  esac
done
export UV_INSTALL_DIR="$HOME/.local/bin"
export UV_NO_MODIFY_PATH=1
export UV_PYTHON_INSTALL_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/uv/python"
export UV_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/uv"
export UV_PYTHON_BIN_DIR="$HOME/.local/bin"
bootstrap_state=${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/bootstrap
mkdir -p "$bootstrap_state"
bootstrap_dir=$(umask 077; mktemp -d "$bootstrap_state/runtime-XXXXXX")
bootstrap_log=$bootstrap_dir/output.log
printf 'Preparing Python runtime...\nLog: %s\n' "$bootstrap_log" >&2
if [ -n "${TERMUX_VERSION:-}" ] || [ "${PREFIX:-}" = /data/data/com.termux/files/usr ]; then
  if ! pkg install -y python >"$bootstrap_log" 2>&1; then
    printf 'Runtime setup failed. Details: %s\n' "$bootstrap_log" >&2; exit 1
  fi
  exec python "$main_script" "$@"
fi
# iSH uses Alpine's native x86 Python; uv has no suitable managed runtime here.
case "$(uname -r)" in
  *-ish*)
    branch=$(cut -d. -f1,2 /etc/alpine-release)
    if [ "$(apk --print-arch)" != x86 ] ||
       { grep -E '^[^#].*/(edge|v[0-9]+\.[0-9]+)(/|$)' /etc/apk/repositories | grep -Ev "/v$branch(/|$)" >/dev/null; }; then
      printf '%s\n' 'Expected Alpine x86 with matching repositories; import a fresh rootfs instead of a cross-version upgrade.' >&2
      exit 1
    fi
    if ! apk add --no-progress python3 >>"$bootstrap_log" 2>&1; then
      printf 'Runtime setup failed. Check matching Alpine repositories. Details: %s\n' "$bootstrap_log" >&2; exit 1
    fi
    if ! runtime_supported python3 >>"$bootstrap_log" 2>&1; then
      printf '%s\n' 'Installed Python cannot execute on this iSH build. See docs/platforms/ish.md for isolated runtime recovery.' >&2
      exit 1
    fi
    exec python3 "$main_script" "$@"
    ;;
esac
if command -v uv >/dev/null 2>&1; then
  bootstrap_uv=$(command -v uv)
elif [ -x "$UV_INSTALL_DIR/uv" ]; then
  bootstrap_uv=$UV_INSTALL_DIR/uv
else
  if ! curl -fsSL https://astral.sh/uv/install.sh -o "$bootstrap_dir/install.sh" >>"$bootstrap_log" 2>&1 ||
     ! sh "$bootstrap_dir/install.sh" >>"$bootstrap_log" 2>&1; then
    printf 'Runtime setup failed. Details: %s\n' "$bootstrap_log" >&2; exit 1
  fi
  bootstrap_uv=$UV_INSTALL_DIR/uv
fi
if ! "$bootstrap_uv" python install --default >>"$bootstrap_log" 2>&1; then
  printf 'Runtime setup failed. Details: %s\n' "$bootstrap_log" >&2; exit 1
fi
bootstrap_python=$("$bootstrap_uv" python find --no-project --managed-python 2>>"$bootstrap_log")
printf '%s\n' 'Python runtime ready.' >&2
exec "$bootstrap_python" "$main_script" "$@"
