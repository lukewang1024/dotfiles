#!/bin/sh
# Wire tmux-agent-sidebar's live-data hooks into Claude Code and TraeX.
#
# The tmux plugin only detects assistant panes; the sidebar shows live
# prompt/task/subagent data only when agent hooks forward
# events to its hook.sh. The plugin does NOT self-install these (its only
# auto-wire path is the `/plugin install` marketplace route, which assumes
# a ~/.tmux/plugins layout we don't use), so we install them here.
#
# Idempotent + self-healing: re-running refreshes stale plugin paths and
# never duplicates entries or clobbers unrelated hooks. Mirrors the
# approach in util/agent/claude-notify-stop and the plugin's own installer.
#
# Usage: agent-sidebar-hooks-install              install / refresh
#        agent-sidebar-hooks-install --uninstall  remove
#        SIDEBAR_HOOKS_CONFIG=/path/to/file agent-sidebar-hooks-install

HOOK="$HOME/.local/share/tmux/plugins/tmux-agent-sidebar/hook.sh"
MARKER="tmux-agent-sidebar/hook.sh"

resolve_script_dir()
{
  path=$0
  if [ -L "$path" ]; then
    link=$(readlink "$path" 2>/dev/null || printf '%s\n' "$path")
    case "$link" in
      /*) path=$link ;;
      *) path=$(dirname "$path")/$link ;;
    esac
  fi
  dir=$(dirname "$path")
  (CDPATH='' cd -- "$dir" 2>/dev/null && pwd) || pwd
}

script_dir=$(resolve_script_dir)
CONFIG_FILE=${SIDEBAR_HOOKS_CONFIG:-"$script_dir/../../config/agent/sidebar-hooks.tsv"}

if ! command -v jq >/dev/null 2>&1; then
  echo "agent-sidebar-hooks-install: jq not found, skipping" >&2
  exit 0
fi

mode="install"
[ "$1" = "--uninstall" ] && mode="uninstall"

[ -f "$CONFIG_FILE" ] || {
  echo "agent-sidebar-hooks-install: config not found: $CONFIG_FILE" >&2
  exit 1
}

tab=$(printf '\t')
while IFS="$tab" read -r agent config_path event sub matcher; do
  case "$agent" in ''|'#'*) continue ;; esac
  case "$config_path" in
    \~/*) settings_file=$HOME/${config_path#\~/} ;;
    *) settings_file=$config_path ;;
  esac

  mkdir -p "$(dirname "$settings_file")"
  [ -f "$settings_file" ] || printf '%s\n' '{}' > "$settings_file"
  cmd="bash $HOOK $agent $sub"
  tmp="$settings_file.tmp"

  # Strip any prior sidebar hook for this subcommand (any path), drop blocks
  # left empty by the strip, then (install only) append the canonical command.
  jq --arg ev "$event" --arg sub "$sub" --arg cmd "$cmd" --arg marker "$MARKER" --arg mode "$mode" --arg agent "$agent" --arg matcher "$matcher" '
    .hooks //= {} |
    .hooks[$ev] //= [] |
    .hooks[$ev] |= map(.hooks = ((.hooks // []) | map(select(
      (((.command // "") | contains($marker)) and ((.command // "") | endswith($agent + " " + $sub))) | not
    )))) |
    .hooks[$ev] |= map(select((.hooks // []) | length > 0)) |
    if $mode == "install" then
      .hooks[$ev] += [{"matcher": $matcher, "hooks": [{"type": "command", "command": $cmd}]}]
    else . end |
    # Tidy: drop the event key entirely if it ended up empty
    if (.hooks[$ev] | length) == 0 then del(.hooks[$ev]) else . end
  ' "$settings_file" > "$tmp" && mv "$tmp" "$settings_file"
done < "$CONFIG_FILE"

if [ "$mode" = "install" ]; then
  echo "agent-sidebar hooks installed from $CONFIG_FILE"
else
  echo "agent-sidebar hooks removed from $CONFIG_FILE"
fi
