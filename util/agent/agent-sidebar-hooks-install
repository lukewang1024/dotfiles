#!/bin/sh
# Wire tmux-agent-sidebar's live-data hooks into configured coding agents.
#
# The tmux plugin only detects assistant panes; the sidebar shows live
# prompt/task/subagent data only when agent hooks forward
# events to its hook.sh. The plugin does NOT self-install these (its only
# auto-wire path is the `/plugin install` marketplace route, which assumes
# a ~/.tmux/plugins layout we don't use), so we install them here.
#
# Idempotent + self-healing: re-running refreshes stale plugin paths and
# never duplicates entries or clobbers unrelated hooks. JSON agents use jq;
# Codex uses its canonical config.toml and migrates sidebar entries out of the
# legacy hooks.json compatibility layer. TraeX uses ~/.trae/cli/hooks.json;
# the old ~/.trae/hooks.json is cleaned so an apparently installed but
# inactive legacy entry cannot leave the setup half-finished.
#
# Usage: agent-sidebar-hooks-install              install / refresh
#        agent-sidebar-hooks-install --uninstall  remove
#        SIDEBAR_HOOKS_CONFIG=/path/to/file agent-sidebar-hooks-install

HOOK="$HOME/.local/share/tmux/plugins/tmux-agent-sidebar/hook.sh"
MARKER="tmux-agent-sidebar/hook.sh"

resolve_script_dir()
{
  path=$0
  if [ -L "$path" ]; then
    link=$(readlink "$path" 2>/dev/null || printf '%s\n' "$path")
    case "$link" in
      /*) path=$link ;;
      *) path=$(dirname "$path")/$link ;;
    esac
  fi
  dir=$(dirname "$path")
  (CDPATH='' cd -- "$dir" 2>/dev/null && pwd) || pwd
}

script_dir=$(resolve_script_dir)
CONFIG_FILE=${SIDEBAR_HOOKS_CONFIG:-"$script_dir/../../config/agent/sidebar-hooks.tsv"}

if ! command -v jq >/dev/null 2>&1; then
  echo "agent-sidebar-hooks-install: jq not found, skipping" >&2
  exit 0
fi

mode="install"
[ "$1" = "--uninstall" ] && mode="uninstall"

[ -f "$CONFIG_FILE" ] || {
  echo "agent-sidebar-hooks-install: config not found: $CONFIG_FILE" >&2
  exit 1
}

tab=$(printf '\t')
while IFS="$tab" read -r agent config_path event sub matcher; do
  case "$agent" in ''|'#'*) continue ;; esac
  case "$config_path" in
    \~/*) settings_file=$HOME/${config_path#\~/} ;;
    *) settings_file=$config_path ;;
  esac

  mkdir -p "$(dirname "$settings_file")"
  cmd="bash $HOOK $agent $sub"
  tmp="$settings_file.tmp"

  if [ "$agent" = "codex" ]; then
    [ -f "$settings_file" ] || : > "$settings_file"

    # A hook group starts at [[hooks.Event]] and includes its nested
    # [[hooks.Event.hooks]] entries. Remove only the matching sidebar command.
    awk -v want_event="$event" -v want_sub="$sub" -v marker="$MARKER" '
      function flush() {
        if (group == "") return
        if (!(group_event == want_event && index(group, marker) &&
              index(group, "codex " want_sub "\"") )) printf "%s", group
        group = ""
        group_event = ""
      }
      /^\[\[hooks\.[^.]+\]\]$/ {
        flush()
        group = $0 ORS
        group_event = $0
        sub(/^\[\[hooks\./, "", group_event)
        sub(/\]\]$/, "", group_event)
        next
      }
      /^\[/ && group != "" && $0 !~ /^\[\[hooks\.[^.]+\.hooks\]\]$/ { flush() }
      { if (group != "") group = group $0 ORS; else print }
      END { flush() }
    ' "$settings_file" > "$tmp" || exit 1

    if [ "$mode" = "install" ]; then
      {
        printf '\n[[hooks.%s]]\n' "$event"
        [ -n "$matcher" ] && printf 'matcher = "%s"\n' "$matcher"
        printf '\n  [[hooks.%s.hooks]]\n' "$event"
        printf '  type = "command"\n'
        printf '  command = "%s"\n' "$cmd"
      } >> "$tmp"
    fi
    mv "$tmp" "$settings_file"

    # Remove the same managed entry from the legacy compatibility file. Keep
    # unrelated hooks, and remove the file only when nothing remains in it.
    legacy_file=$HOME/.codex/hooks.json
    if [ -f "$legacy_file" ]; then
      legacy_tmp=$legacy_file.tmp
      jq --arg ev "$event" --arg sub "$sub" --arg marker "$MARKER" '
        if (.hooks[$ev] // null) != null then
          .hooks[$ev] |= map(.hooks = ((.hooks // []) | map(select(
            ((((.command // "") | contains($marker)) and
              ((.command // "") | endswith("codex " + $sub)))) | not
          )))) |
          .hooks[$ev] |= map(select((.hooks // []) | length > 0)) |
          if (.hooks[$ev] | length) == 0 then del(.hooks[$ev]) else . end
        else . end |
        if ((.hooks // {}) | length) == 0 then del(.hooks) else . end
      ' "$legacy_file" > "$legacy_tmp" || exit 1
      if jq -e 'length == 0' "$legacy_tmp" >/dev/null; then
        rm "$legacy_file" "$legacy_tmp"
      else
        mv "$legacy_tmp" "$legacy_file"
      fi
    fi
    continue
  fi

  [ -f "$settings_file" ] || printf '%s\n' '{}' > "$settings_file"

  # Strip any prior sidebar hook for this subcommand (any path), drop blocks
  # left empty by the strip, then (install only) append the canonical command.
  jq --arg ev "$event" --arg sub "$sub" --arg cmd "$cmd" --arg marker "$MARKER" --arg mode "$mode" --arg agent "$agent" --arg matcher "$matcher" '
    .hooks //= {} |
    .hooks[$ev] //= [] |
    .hooks[$ev] |= map(.hooks = ((.hooks // []) | map(select(
      (((.command // "") | contains($marker)) and ((.command // "") | endswith($agent + " " + $sub))) | not
    )))) |
    .hooks[$ev] |= map(select((.hooks // []) | length > 0)) |
    if $mode == "install" then
      .hooks[$ev] += [{"matcher": $matcher, "hooks": [{"type": "command", "command": $cmd}]}]
    else . end |
    # Tidy: drop the event key entirely if it ended up empty
    if (.hooks[$ev] | length) == 0 then del(.hooks[$ev]) else . end
  ' "$settings_file" > "$tmp" && mv "$tmp" "$settings_file"

  if [ "$agent" = "traex" ]; then
    # TraeX 0.20x reads ~/.trae/cli/hooks.json. Remove only our old root-level
    # entries; preserve unrelated legacy hooks and keep the file valid JSON.
    legacy_file=$HOME/.trae/hooks.json
    if [ -f "$legacy_file" ]; then
      legacy_tmp=$legacy_file.tmp
      jq --arg ev "$event" --arg sub "$sub" --arg marker "$MARKER" '
        if (.hooks[$ev] // null) != null then
          .hooks[$ev] |= map(.hooks = ((.hooks // []) | map(select(
            ((((.command // "") | contains($marker)) and
              ((.command // "") | endswith("traex " + $sub)))) | not
          )))) |
          .hooks[$ev] |= map(select((.hooks // []) | length > 0)) |
          if (.hooks[$ev] | length) == 0 then del(.hooks[$ev]) else . end
        else . end
      ' "$legacy_file" > "$legacy_tmp" || exit 1
      mv "$legacy_tmp" "$legacy_file"
    fi
  fi
done < "$CONFIG_FILE"

if [ "$mode" = "install" ]; then
  echo "agent-sidebar hooks installed from $CONFIG_FILE"
else
  echo "agent-sidebar hooks removed from $CONFIG_FILE"
fi
