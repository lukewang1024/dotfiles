#!/bin/sh
# Install the small public skill set managed by this dotfiles repository.

set -eu

# Local skills install independently of network-installed public skills.
agent_dotfiles=${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles
agent_skill_source=$agent_dotfiles/config/agent/skills/code-ship
for agent_skill_dir in "$HOME/.agents/skills" "$HOME/.codex/skills" "$HOME/.claude/skills" "${XDG_CONFIG_HOME:-$HOME/.config}/opencode/skills" "$HOME/.openclaw/skills"; do
  mkdir -p "$agent_skill_dir"
  agent_skill_target=$agent_skill_dir/code-ship
  if [ -L "$agent_skill_target" ]; then
    agent_skill_current=$(readlink "$agent_skill_target")
    if [ "$agent_skill_current" = "$agent_skill_source" ]; then
      continue
    fi
    case "$agent_skill_current" in
      */harness/skills/code-ship) rm "$agent_skill_target" ;;
      *) echo "agent-skills-install: preserving $agent_skill_target" >&2; continue ;;
    esac
  elif [ -e "$agent_skill_target" ]; then
    echo "agent-skills-install: preserving $agent_skill_target" >&2
    continue
  fi
  ln -s "$agent_skill_source" "$agent_skill_target"
done
mkdir -p "$HOME/.local/bin"
agent_command_target=$HOME/.local/bin/code-ship
agent_command_source=$agent_dotfiles/util/agent/code-ship
if [ -L "$agent_command_target" ]; then
  case "$(readlink "$agent_command_target")" in
    */harness/scripts/code-ship.sh) rm "$agent_command_target" ;;
  esac
fi
if [ ! -e "$agent_command_target" ] && [ ! -L "$agent_command_target" ]; then
  ln -s "$agent_command_source" "$agent_command_target"
fi
[ "${1:-}" != --local-only ] || exit 0

if [ -f "$HOME/.agents/skills/grill-me/SKILL.md" ] &&
  [ -f "$HOME/.agents/skills/grill-with-docs/SKILL.md" ] &&
  [ -f "$HOME/.claude/skills/grill-me/SKILL.md" ] &&
  [ -f "$HOME/.claude/skills/grill-with-docs/SKILL.md" ]; then
  echo 'agent-skills-install: grill-me and grill-with-docs already installed'
  exit 0
fi

if ! command -v npx >/dev/null 2>&1; then
  echo 'agent-skills-install: skipping; npx is not installed' >&2
  exit 0
fi

npx --yes skills@latest add mattpocock/skills \
  --global \
  --agent claude-code codex opencode \
  --skill grill-me grill-with-docs \
  --yes
