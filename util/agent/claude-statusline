#!/bin/sh
# Portable Claude Code statusline entrypoint for the claude-hud plugin.
# Keep machine-specific runtime discovery out of ~/.claude/settings.json.

cols=$( { stty size </dev/tty; } 2>/dev/null | awk '{print $2}')
case $cols in
  ''|*[!0-9]*) cols=120 ;;
esac
if [ "$cols" -gt 4 ]; then COLUMNS=$((cols - 4)); else COLUMNS=1; fi
export COLUMNS

node_bin=$(command -v node 2>/dev/null || true)
if [ -z "$node_bin" ]; then
  for candidate in \
    "$HOME/.local/share/anyenv/envs/nodenv/shims/node" \
    /opt/homebrew/bin/node \
    /home/linuxbrew/.linuxbrew/bin/node \
    /usr/local/bin/node \
    /usr/bin/node
  do
    if [ -x "$candidate" ]; then node_bin=$candidate; break; fi
  done
fi
[ -n "$node_bin" ] || exit 0

plugin_root=${CLAUDE_CONFIG_DIR:-"$HOME/.claude"}/plugins/cache
plugin_dir=$(
  for dir in "$plugin_root"/*/claude-hud/*/; do
    [ -f "${dir}dist/index.js" ] || continue
    version=${dir%/}
    version=${version##*/}
    printf '%s\t%s\n' "$version" "$dir"
  done | awk -F '\t' '
    $1 ~ /^[0-9]+\.[0-9]+\.[0-9]+/ {
      split($1, v, /[.-]/)
      printf "%09d.%09d.%09d\t%s\n", v[1], v[2], v[3], $2
    }
  ' | sort | tail -n 1 | cut -f 2-
)
[ -n "$plugin_dir" ] || exit 0

# Claude includes current 5h/7d plan utilization in the statusline payload.
# Preserve a small, credential-free snapshot for the tmux usage badge.
input=$(cat)
usage_dir=${XDG_STATE_HOME:-$HOME/.local/state}/tmux-agent-workbench/usage
if command -v jq >/dev/null 2>&1 && [ -n "$input" ]; then
  limits=$(printf '%s\n' "$input" | jq -c '
    select(.rate_limits != null)
    | {updated_at: now, rate_limits: .rate_limits}
  ' 2>/dev/null)
  if [ -n "$limits" ]; then
    mkdir -p "$usage_dir" 2>/dev/null || true
    printf '%s\n' "$limits" > "$usage_dir/claude-limits.$$" 2>/dev/null &&
      mv "$usage_dir/claude-limits.$$" "$usage_dir/claude-limits"
  fi
fi

printf '%s\n' "$input" | exec "$node_bin" "${plugin_dir}dist/index.js"
