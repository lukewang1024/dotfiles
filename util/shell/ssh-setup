#!/bin/sh
# Alpine/iSH SSH service setup; independent of the Python bootstrap.
set -eu
usage() {
    echo 'usage: ./init sshd [--port PORT] [--random-password | --set-password | --key-only] [--foreground | --background | --enable-autostart]'
    echo 'Default: enable autostart and start SSH in background using OpenRC; reuse root password.'
    echo '--foreground: diagnostic mode; --background: daemonize without configuring autostart.'
}
port=2222
mode=reuse
launch=autostart
while [ "$#" -gt 0 ]; do
    case $1 in
        --port) [ "$#" -ge 2 ] || { usage >&2; exit 2; }; port=$2; shift ;;
        --random-password) mode=random ;;
        --set-password) mode='set' ;;
        --key-only) mode=key ;;
        --background) launch=background ;;
        --enable-autostart) launch=autostart ;;
        --foreground) launch=foreground ;;
        -h|--help) usage; exit 0 ;;
        *) usage >&2; exit 2 ;;
    esac
    shift
done
case $port in ''|*[!0-9]*) echo 'Invalid port' >&2; exit 2 ;; esac
[ "$port" -ge 1024 ] && [ "$port" -le 65535 ] || { echo 'Use port 1024..65535' >&2; exit 2; }
[ "$(id -u)" = 0 ] || { echo 'Run this command as root inside Alpine/iSH.' >&2; exit 1; }
command -v apk >/dev/null 2>&1 || { echo 'ssh-setup currently supports Alpine/iSH only.' >&2; exit 1; }
umask 077
state=${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/sshd
mkdir -p "$state"
if [ "$mode" != key ]; then
    hash=$(awk -F: '$1 == "root" {print $2}' /etc/shadow)
    case $hash in ''|'!'*|'*'*) [ "$mode" != reuse ] || mode='set' ;; esac
    case $mode in
        set)
            echo 'Set the iSH root password (not the iPad unlock password):' >&2
            passwd root ;;
        random)
            [ -t 0 ] && [ -t 1 ] || { echo 'Random password must be displayed on a terminal, not redirected into a log.' >&2; exit 1; }
            echo 'This replaces the iSH root password. Continue? [y/N]' >&2
            IFS= read -r answer
            [ "$answer" = y ] || exit 1
            password=$(od -An -N18 -tx1 /dev/urandom | tr -d ' \n')
            printf 'root:%s\n' "$password" | chpasswd
            printf '\nTemporary iSH root password: %s\nDo not share or log this password.\n\n' "$password"
            unset password ;;
    esac
fi
echo 'Installing SSH server (keeps the existing SSH client selection)...' >&2
apk add openssh-server
if [ ! -f /etc/ssh/ssh_host_ed25519_key ]; then
    echo 'Generating the ED25519 host key...' >&2
    ssh-keygen -t ed25519 -N '' -f /etc/ssh/ssh_host_ed25519_key
fi
password_auth=yes
root_login=yes
if [ "$mode" = key ]; then
    [ -s "$HOME/.ssh/authorized_keys" ] || { echo 'No authorized_keys; pair with a client before using --key-only.' >&2; exit 1; }
    password_auth=no
    root_login=prohibit-password
fi
config=$state/sshd_config
cat > "$config" <<CONFIG
Port $port
ListenAddress 0.0.0.0
HostKey /etc/ssh/ssh_host_ed25519_key
PidFile $state/sshd.pid
AuthorizedKeysFile .ssh/authorized_keys
PermitRootLogin $root_login
PasswordAuthentication $password_auth
PubkeyAuthentication yes
KbdInteractiveAuthentication no
PermitEmptyPasswords no
AllowUsers root
Subsystem sftp internal-sftp
CONFIG
/usr/sbin/sshd -t -f "$config"
if [ "$launch" = autostart ]; then
    # OpenRC runs without the interactive shell's HOME/XDG environment. Keep a
    # self-contained service configuration rather than rerunning provisioning.
    apk add openrc
    service=/etc/init.d/dotfiles-sshd
    if [ -e "$service" ] && ! grep -q '^# Managed by dotfiles ssh-setup$' "$service"; then
        echo "Refusing to replace unmanaged service: $service" >&2
        exit 1
    fi
    service_config=/etc/ssh/sshd_config.dotfiles
    if [ -e "$service_config" ]; then
        backup=$(mktemp /etc/ssh/sshd_config.dotfiles.before.XXXXXX)
        cp -p "$service_config" "$backup"
    fi
    sed 's|^PidFile .*|PidFile /run/dotfiles-sshd.pid|' "$config" > "$service_config"
    chmod 600 "$service_config"
    /usr/sbin/sshd -t -f "$service_config"
    cat > "$service" <<'SERVICE'
#!/sbin/openrc-run
# Managed by dotfiles ssh-setup
description="Dotfiles iSH SSH server"
command=/usr/sbin/sshd
command_args="-f /etc/ssh/sshd_config.dotfiles"
pidfile=/run/dotfiles-sshd.pid
logfile=${XDG_STATE_HOME:-/root/.local/state}/dotfiles/sshd/service.log
start_pre() {
    mkdir -p "${logfile%/*}"
    /usr/sbin/sshd -t -f /etc/ssh/sshd_config.dotfiles
}
# iSH can run sshd directly but OpenRC's executable matching in
# start-stop-daemon fails there. Manage only this service's recorded PID.
running() {
    [ -r "$pidfile" ] || return 1
    IFS= read -r service_pid < "$pidfile" || return 1
    case $service_pid in ''|*[!0-9]*|0|1) return 1 ;; esac
    kill -0 "$service_pid" 2>/dev/null
}
start() {
    ebegin "Starting $RC_SVCNAME"
    /usr/sbin/sshd -E "$logfile" -f /etc/ssh/sshd_config.dotfiles
    result=$?
    if [ "$result" -eq 0 ]; then
        # The daemonizing parent exits before the child writes its PID file.
        remaining=5
        while ! running && [ "$remaining" -gt 0 ]; do
            sleep 1
            remaining=$((remaining - 1))
        done
        running || result=1
    fi
    eend "$result"
    if [ "$result" -ne 0 ]; then
        tail -n 15 "$logfile" >&2
    fi
    return "$result"
}
stop() {
    ebegin "Stopping $RC_SVCNAME"
    if running; then
        kill "$service_pid" || { eend 1; return 1; }
        remaining=5
        while kill -0 "$service_pid" 2>/dev/null; do
            [ "$remaining" -gt 0 ] || { eend 1; return 1; }
            sleep 1
            remaining=$((remaining - 1))
        done
    fi
    rm -f "$pidfile"
    eend 0
}
status() {
    if running; then
        einfo "$RC_SVCNAME is running (PID $service_pid)"
        return 0
    fi
    eerror "$RC_SVCNAME is stopped"
    return 3
}
SERVICE
    chmod 755 "$service"
    # A newly installed OpenRC has not yet entered a runlevel in this session.
    # Initialize it now so the current invocation works without an app restart.
    if [ ! -f /run/openrc/softlevel ]; then
        if ! openrc default; then
            # iSH lacks some hardware services; their failures must not mask
            # successful initialization of the OpenRC runtime itself.
            [ -f /run/openrc/softlevel ] || {
                echo 'OpenRC initialization failed; SSH service was not started.' >&2
                exit 1
            }
        fi
    fi
    rc-update add dotfiles-sshd default
    echo 'Autostart enabled for iSH startup. iPadOS may still suspend iSH in the background.' >&2
    echo 'Manage with: rc-service dotfiles-sshd {start|stop|restart|status}' >&2
    echo 'Disable autostart with: rc-update del dotfiles-sshd default' >&2
    rc-service dotfiles-sshd restart
    rc-service dotfiles-sshd status
    echo "SSH is running in background on TCP $port. Verify this host fingerprint:" >&2
    ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub
    echo "On the computer: ./init pair ipad-ish IP_ADDRESS --port $port --user root" >&2
    exit 0
fi
echo 'Verify this host fingerprint on the pairing computer:' >&2
ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub
echo "Listening on TCP $port. Use the iPad Wi-Fi address, not localhost." >&2
echo "On the computer: ./init pair ipad-ish IP_ADDRESS --port $port --user root" >&2
if [ "$launch" = background ]; then
    /usr/sbin/sshd -E "$state/sshd.log" -f "$config"
    echo "SSH server started in background. Log: $state/sshd.log" >&2
    echo "PID file: $state/sshd.pid" >&2
    echo 'Keep iSH foreground/unlocked; terminal background mode does not prevent iPadOS suspension.' >&2
    exit 0
fi
echo 'Keep iSH foreground/unlocked. Ctrl-C stops this server.' >&2
exec /usr/sbin/sshd -D -e -f "$config"
