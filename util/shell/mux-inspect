#!/bin/sh
# mux-inspect — add (or focus) a per-repo inspection window in the current tmux
# session: git (tig) as the main pane, a shell beneath it, cwd = the repo.
#
# This is the single, agent-agnostic entry point for bringing a repo into a task
# session under the window-per-role model. A task == one session with one agent
# window; each repo the task touches gets its own full-screen inspection window,
# created lazily. Two callers:
#
#   - the prefix+G picker (mux-inspect-pick): manual — pick a repo, --focus to it.
#   - the coding agent itself, per the AGENTS.md / CLAUDE.md convention, when its
#     work reaches into another repo. There is no reliable cross-agent signal for
#     "the agent just gained a directory" (Claude's /add-dir fires no hook; codex
#     and opencode have none either), so we invert control: the agent announces a
#     scope change by running this command. Created detached by default so the
#     window appears without stealing focus.
#
# Growing the agent's own write scope is the agent's job, not this command's
# (claude: /add-dir; codex: reads by default, relaunch with --add-dir to write;
# opencode: references / external_directory). See mux-agent.
#
# usage: mux-inspect <repo-path> [--focus]
set -eu

[ $# -ge 1 ] || { echo "usage: mux-inspect <repo-path> [--focus]" >&2; exit 2; }
path=$1; shift
focus=0
for a in "$@"; do
  case $a in
    --focus) focus=1 ;;
    *) echo "mux-inspect: unknown arg: $a" >&2; exit 2 ;;
  esac
done

[ -n "${TMUX:-}" ] || { echo "mux-inspect: not inside a tmux session" >&2; exit 1; }
path=$(cd "$path" 2>/dev/null && pwd -P) || { echo "mux-inspect: no such dir: $1" >&2; exit 1; }

sess=$(tmux display-message -p '#S')
name=$(basename "$path" | tr ' .:/' '____')   # tmux-safe window name

# Idempotent: if the inspection window already exists, don't rebuild it — just
# optionally focus it. Keeps re-adds (agent + human racing on the same repo) safe.
if tmux list-windows -t "$sess" -F '#W' | grep -qxF "$name"; then
  [ "$focus" = 1 ] && tmux select-window -t "$sess:$name"
  exit 0
fi

# Build detached: tig on top (main pane, full width), a shell beneath it.
tmux new-window -d -t "$sess:" -n "$name" -c "$path"
tmux split-window -v -t "$sess:$name" -c "$path"
tmux select-layout -t "$sess:$name" main-horizontal
tmux send-keys -t "$sess:$name.1" 'tig' Enter
tmux select-pane -t "$sess:$name.2"           # land in the shell, not inside tig

[ "$focus" = 1 ] && tmux select-window -t "$sess:$name"
exit 0
