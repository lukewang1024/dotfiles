#!/bin/sh

# Pick a concrete OpenSSH Host alias and connect to it. The optional inventory
# is intentionally only a list of aliases; connection details remain in the
# standard SSH config.

set -eu

xdg_config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
ssh_dir=${SSH_CONNECT_SSH_DIR:-"$HOME/.ssh"}
hosts_file=${SSH_CONNECT_HOSTS_FILE:-"$xdg_config_home/ssh/hosts"}

usage()
{
  cat <<'EOF'
usage: ssh-connect [--print | --check | --tmux | --workbench] [--no-reconnect] [-- SSH_OPTIONS...]
       ssh-connect hosts path
       ssh-connect hosts list
       ssh-connect hosts discover
       ssh-connect hosts edit [--discover]
       ssh-connect connect HOST [--check | --tmux | --workbench] [--no-reconnect] [-- SSH_OPTIONS...]

Pick an alias from the SSH host inventory and connect. `--workbench` uses the
client-aware tmux-agent-workbench SSH transport so mobile completion and input
notifications return to this device. `hosts edit --discover` merges concrete
Host aliases found in SSH config files before opening $EDITOR.
Interactive --tmux and --workbench connections retry up to 5 times, waiting
1/2/4/8/16 seconds after failures. Connection and ticket-refresh time do not
consume retries or shorten the waits. Then wait for manual retries. Press Enter
while waiting to retry immediately; Ctrl-C exits. Manual retries do not reset
the automatic budget. Normal detach/exit stops.
Use --no-reconnect for a single attempt. Plain SSH and --check never retry.
Kerberos mappings: $XDG_CONFIG_HOME/ssh/kerberos, lines HOST PRINCIPAL [SESSION].
Existing iSH user.conf is also supported. GSSAPI hosts require a matching
TGT; an interactive kinit is requested when needed. --check never prompts and
runs whoami with trusted host keys. Passwords are never stored.
EOF
}

discover_hosts()
{
  [ -d "$ssh_dir" ] || return 0
  find "$ssh_dir" -type f \( \
    -name config -o -name config.local -o -name '*.conf' \
  \) -print 2>/dev/null |
    while IFS= read -r config_file; do
      awk '
        tolower($1) == "host" {
          for (field = 2; field <= NF; field++) {
            host = $field
            if (host !~ /^!/ && host !~ /^-/ && host !~ /[*!?]/) print host
          }
        }
      ' "$config_file"
    done |
    awk '!seen[$0]++'
}

inventory_hosts()
{
  source_file=$1
  awk '
    {
      sub(/[[:space:]]*#.*/, "")
      gsub(/^[[:space:]]+|[[:space:]]+$/, "")
      if ($0 != "" && NF == 1) print
    }
  ' "$source_file"
}

validate_inventory()
{
  awk '
    {
      line = $0
      sub(/[[:space:]]*#.*/, "", line)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", line)
      if (line == "") next
      if (line ~ /^-/ || line ~ /[*!?]/ || split(line, fields, /[[:space:]]+/) != 1) {
        printf "ssh-connect: invalid host alias on line %d: %s\n", NR, $0 > "/dev/stderr"
        invalid = 1
      }
    }
    END { exit invalid ? 1 : 0 }
  ' "$1"
}

effective_hosts()
{
  if [ -f "$hosts_file" ]; then
    validate_inventory "$hosts_file"
    inventory_hosts "$hosts_file"
  else
    ish_profile=${ISH_CONFIG_DIR:-$xdg_config_home/ish-kerberos}/user.conf
    if [ -f "$ish_profile" ]; then
      awk -F= '$1 == "SSH_HOST" && $2 ~ /^[A-Za-z0-9_][A-Za-z0-9_.:-]*$/ {print $2}' "$ish_profile"
    else
      discover_hosts
    fi
  fi
}

edit_hosts()
{
  merge_discovered=${1:-0}
  hosts_dir=$(dirname "$hosts_file")
  mkdir -p "$hosts_dir"
  edit_file=$(mktemp "$hosts_dir/.hosts.edit.XXXXXX")
  aliases_file=$(mktemp "$hosts_dir/.hosts.aliases.XXXXXX")
  discovered_file=$(mktemp "$hosts_dir/.hosts.discovered.XXXXXX")
  trap 'rm -f "$edit_file" "$aliases_file" "$discovered_file"' EXIT HUP INT TERM

  if [ -f "$hosts_file" ]; then
    cp "$hosts_file" "$edit_file"
  else
    cat >"$edit_file" <<'EOF'
# SSH picker hosts. One concrete Host alias per line; order is preserved.
# Connection details belong in ~/.ssh/config or ~/.ssh/config.local.
EOF
  fi

  if [ "$merge_discovered" -eq 1 ] || [ ! -f "$hosts_file" ]; then
    inventory_hosts "$edit_file" >"$aliases_file"
    discover_hosts >"$discovered_file"
    while IFS= read -r host; do
      grep -Fxq "$host" "$aliases_file" 2>/dev/null && continue
      printf '%s\n' "$host" >>"$edit_file"
      printf '%s\n' "$host" >>"$aliases_file"
    done <"$discovered_file"
  fi

  editor=${VISUAL:-${EDITOR:-vi}}
  command -v "$editor" >/dev/null 2>&1 || {
    printf 'ssh-connect: editor not found: %s\n' "$editor" >&2
    exit 127
  }
  "$editor" "$edit_file"
  validate_inventory "$edit_file"
  chmod 600 "$edit_file"
  mv "$edit_file" "$hosts_file"
  trap - EXIT HUP INT TERM
  rm -f "$aliases_file" "$discovered_file"
  printf 'ssh-connect: saved %s\n' "$hosts_file" >&2
}

choose_host()
{
  choices_file=$1
  if [ "$(wc -l <"$choices_file" | tr -d ' ')" -eq 1 ]; then
    cat "$choices_file"
    return
  fi
  if command -v fzf >/dev/null 2>&1; then
    fzf --prompt='SSH host> ' --reverse <"$choices_file"
    return
  fi

  awk '{ printf "%d) %s\n", NR, $0 }' "$choices_file" >&2
  printf '%s' 'SSH host number: ' >&2
  IFS= read -r choice </dev/tty || return 1
  case $choice in
    ''|*[!0-9]*) return 1 ;;
  esac
  sed -n "${choice}p" "$choices_file"
}

restore_retry_terminal()
{
  stty "$retry_tty_state" 2>/dev/null || :
}

reset_connection_terminal_modes()
{
  [ -t 0 ] && [ -t 2 ] || return 0
  # A disconnected remote tmux may leave mouse tracking enabled in our pane.
  printf '\033[?1000l\033[?1002l\033[?1003l\033[?1006l\033[?1015l' >&2
}

cleanup_retry_session()
{
  restore_retry_terminal
  [ -z "$retry_error_log" ] || rm -f "$retry_error_log"
}

run_connection_attempt()
{
  if [ -n "$retry_error_log" ]; then
    : >"$retry_error_log"
    if "$@" 2>"$retry_error_log"; then
      connection_status=0
    else
      connection_status=$?
    fi
    reset_connection_terminal_modes
    if [ -s "$retry_error_log" ]; then
      printf 'ssh-connect: workbench diagnostics:\n' >&2
      sed 's/^/  /' "$retry_error_log" >&2
    fi
    return "$connection_status"
  fi

  if "$@"; then
    reset_connection_terminal_modes
    return 0
  else
    connection_status=$?
  fi
  reset_connection_terminal_modes
  return "$connection_status"
}

wait_for_retry_input()
{
  if [ "$1" -eq 0 ]; then
    # No timer in manual mode: leave an ordinary line prompt, with Ctrl-C.
    stty icanon echo isig icrnl -igncr -inlcr intr '^C' || return 1
    if IFS= read -r _retry_line; then
      restore_retry_terminal
      return 0
    fi
    restore_retry_terminal
    return 1
  fi

  # POSIX read has no timeout option. VMIN=0/VTIME=10 makes dd's one-byte
  # read wake on a key or after one second, without a background timer.
  stty -icanon -echo isig icrnl -igncr -inlcr intr '^C' min 0 time 10 || return 1
  while [ "$(date +%s)" -lt "$1" ]; do
    # The trailing dot preserves a newline through command substitution.
    retry_key=$(dd bs=1 count=1 2>/dev/null && printf '.') || {
      restore_retry_terminal
      return 1
    }
    case $retry_key in
      '
.') break ;;
    esac
  done
  restore_retry_terminal
}

wait_to_reconnect()
{
  if [ "$retry_count" -lt 5 ]; then
    retry_wait=$retry_delay
    printf 'ssh-connect: %s disconnected (exit %s); retry %s/5 in %ss. Press Enter to retry now; Ctrl-C to exit.\n' \
      "$host" "$connection_status" "$((retry_count + 1))" "$retry_wait" >&2
    wait_for_retry_input "$(($(date +%s) + retry_wait))"
    return $?
  fi
  printf 'ssh-connect: %s disconnected (exit %s); automatic reconnect limit reached (5/5 retries). Press Enter to retry; Ctrl-C to exit.\n' \
    "$host" "$connection_status" >&2
  wait_for_retry_input 0
}

connect_session()
{
  retry_error_log=''
  if [ "$reconnect" -eq 0 ] || [ ! -t 0 ]; then
    if run_connection_attempt "$@"; then
      return 0
    else
      connection_status=$?
    fi
    return "$connection_status"
  fi

  retry_tty_state=$(stty -g) || return 1
  if [ "$attach_workbench" -eq 1 ]; then
    retry_error_log=$(mktemp "${TMPDIR:-/tmp}/ssh-connect.XXXXXX" 2>/dev/null) || retry_error_log=''
  fi
  trap 'cleanup_retry_session' EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  retry_delay=1
  retry_count=0
  while :; do
    if run_connection_attempt "$@"; then
      return 0
    else
      connection_status=$?
    fi
    # Workbench collapses errors to 1; OpenSSH reports SSH failures as 255.
    # Other exit codes, including interrupted commands, stop the retry loop.
    case "$attach_workbench:$connection_status" in
      1:1|*:255) ;;
      *) return "$connection_status" ;;
    esac
    while :; do
      wait_to_reconnect || return "$connection_status"
      # A long outage can outlive the TGT. Recheck it after waiting, with the
      # normal terminal settings restored before a possible kinit prompt.
      if [ "$kerberos_enabled" = 1 ]; then
        require_tgt
      fi
      retry_manual=1
      if [ "$retry_count" -lt 5 ]; then
        retry_count=$((retry_count + 1))
        retry_delay=$((retry_delay * 2))
        retry_manual=0
      fi
      printf '\033[2J\033[H' >&2
      if [ "$retry_manual" -eq 1 ]; then
        printf '%s\n' 'ssh-connect: reconnecting (manual)...' >&2
      else
        printf 'ssh-connect: reconnecting (%s/5)...\n' "$retry_count" >&2
      fi
      break
    done
  done
}

if [ "${1:-}" = hosts ]; then
  shift
  case ${1:-} in
    path)
      [ "$#" -eq 1 ] || { usage >&2; exit 2; }
      printf '%s\n' "$hosts_file"
      ;;
    list)
      [ "$#" -eq 1 ] || { usage >&2; exit 2; }
      effective_hosts
      ;;
    discover)
      [ "$#" -eq 1 ] || { usage >&2; exit 2; }
      discover_hosts
      ;;
    edit)
      shift
      case ${1:-} in
        '') edit_hosts 0 ;;
        --discover) [ "$#" -eq 1 ] || { usage >&2; exit 2; }; edit_hosts 1 ;;
        *) usage >&2; exit 2 ;;
      esac
      ;;
    *) usage >&2; exit 2 ;;
  esac
  exit 0
fi

if [ "${1:-}" = connect ]; then
  [ "$#" -ge 2 ] || { usage >&2; exit 2; }
  requested_host=$2
  effective_hosts | grep -Fxq "$requested_host" || {
    printf 'ssh-connect: host is not in the effective inventory: %s\n' "$requested_host" >&2
    exit 2
  }
  shift 2
else
  requested_host=''
fi

print_only=0
check_only=0
attach_tmux=0
attach_workbench=0
reconnect=1
while [ "$#" -gt 0 ]; do
  case $1 in
    --check) check_only=1; shift ;;
    --print) print_only=1; shift ;;
    --tmux) attach_tmux=1; shift ;;
    --workbench) attach_workbench=1; shift ;;
    --no-reconnect) reconnect=0; shift ;;
    -h|--help) usage; exit 0 ;;
    --) shift; break ;;
    *) break ;;
  esac
done

[ "$((attach_tmux + attach_workbench + check_only + print_only))" -le 1 ] || {
  printf '%s\n' 'ssh-connect: --print, --check, --tmux and --workbench are mutually exclusive' >&2
  exit 2
}

choices_file=$(mktemp "${TMPDIR:-/tmp}/ssh-connect.XXXXXX")
trap 'rm -f "$choices_file"' EXIT HUP INT TERM
effective_hosts >"$choices_file"
[ -s "$choices_file" ] || {
  printf '%s\n' 'ssh-connect: no hosts found; run: ssh-connect hosts edit --discover' >&2
  exit 1
}

if [ -n "$requested_host" ]; then
  host=$requested_host
else
  if [ "$check_only" = 1 ] && [ "$(wc -l <"$choices_file" | tr -d ' ')" -ne 1 ]; then
    printf '%s\n' 'ssh-connect: --check requires one host; use: ssh-connect connect HOST --check' >&2
    exit 2
  fi
  host=$(choose_host "$choices_file") || exit 1
fi
rm -f "$choices_file"
trap - EXIT HUP INT TERM
[ -n "$host" ] || exit 1
if [ "$print_only" -eq 1 ]; then
  printf '%s\n' "$host"
  exit 0
fi

# Resolve the installed symlink without requiring GNU readlink -f on macOS.
script_path=$0
while [ -L "$script_path" ]; do
  link=$(readlink "$script_path")
  case "$link" in /*) script_path=$link ;; *) script_path=$(dirname "$script_path")/$link ;; esac
done
script_dir=$(CDPATH='' cd -- "$(dirname "$script_path")" && pwd)
# shellcheck source=util/shell/ssh-kerberos.sh
. "$script_dir/ssh-kerberos.sh"
load_ssh_kerberos "$@"

if [ "$attach_workbench" -eq 1 ]; then
  [ "$#" -eq 0 ] || die 'SSH_OPTIONS are not supported with --workbench; put them in SSH config.'
  command -v tmux-agent-workbench >/dev/null 2>&1 || die 'tmux-agent-workbench is not installed; use --tmux.'
  if [ "$kerberos_enabled" = 1 ]; then
    check_workbench_policy
    require_tgt
  fi
  connect_session tmux-agent-workbench client attach "$host"
  exit 0
fi

if [ "$kerberos_enabled" = 1 ]; then
  require_tgt
  if [ "$check_only" = 1 ]; then
    HOST_KEY_POLICY=yes
  else
    HOST_KEY_POLICY=ask
    printf '%s\n' 'First connection: verify the host fingerprint through a trusted channel before accepting.' >&2
  fi
  if [ "$ish_connection" = 1 ]; then
    set -- -F /dev/null -p "$SSH_PORT" -l "$SSH_USER" "$@"
  fi
fi

connect_ssh() {
  if [ "$kerberos_enabled" = 1 ]; then
    ssh_gssapi_command "$@"
  else
    ssh "$@"
  fi
}

if [ "$check_only" = 1 ]; then
  connect_ssh -o BatchMode=yes -o StrictHostKeyChecking=yes "$@" "$host" whoami
elif [ "$attach_tmux" -eq 1 ]; then
  if [ "$reconnect" -eq 1 ] && [ -t 0 ]; then
    # Detect a dead transport promptly instead of waiting on the OS TCP timer.
    ssh_alive_interval=5
    set -- "$@" -o ConnectTimeout=10 -o TCPKeepAlive=no \
      -o ServerAliveInterval=5 -o ServerAliveCountMax=3
  fi
  if [ "$kerberos_enabled" = 1 ]; then
    connect_session connect_ssh "$@" -t "$host" "exec tmux new-session -A -s $TMUX_SESSION"
  else
    connect_session connect_ssh "$@" -t "$host" 'if command -v tmux-agent-workbench >/dev/null 2>&1; then exec tmux-agent-workbench client attach; else tmux attach-session || exec tmux new-session; fi'
  fi
else
  connect_ssh "$@" "$host"
fi
