#!/bin/sh

# Fast-forward the dotfiles, agent-team, and the two locally maintained tmux
# plugins, then re-apply their installation steps to the current machine.

set -eu

log_file=$(mktemp "${TMPDIR:-/tmp}/tmux-workbench-update.XXXXXX")
workbench_release_tmp=
workbench_core_stage=

cleanup()
{
  rm -f "$log_file"
  [ -z "$workbench_release_tmp" ] || rm -rf "$workbench_release_tmp"
  [ -z "$workbench_core_stage" ] || rm -f "$workbench_core_stage"
}

trap cleanup 0 1 2 3 15

expand_home()
{
  case $1 in
    \~) printf '%s\n' "$HOME" ;;
    \~/*) printf '%s%s\n' "$HOME" "${1#\~}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

xdg_config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
xdg_data_home=${XDG_DATA_HOME:-"$HOME/.local/share"}
dotfiles_dir=${DOTFILES_DIR:-"$xdg_config_home/dotfiles"}
agent_team_dir=${AGENT_TEAM_REPO:-"${XDG_DATA_HOME:-$HOME/.local/share}/agent-team"}
plugins_dir=${TMUX_PLUGIN_MANAGER_PATH:-"$xdg_data_home/tmux/plugins"}
bin_dir=${XDG_BIN_HOME:-"$HOME/.local/bin"}
xdg_config_home=$(expand_home "$xdg_config_home")
xdg_data_home=$(expand_home "$xdg_data_home")
dotfiles_dir=$(expand_home "$dotfiles_dir")
agent_team_dir=$(expand_home "$agent_team_dir")
plugins_dir=$(expand_home "$plugins_dir")
bin_dir=$(expand_home "$bin_dir")
workbench_dir=$plugins_dir/tmux-agent-workbench
theme_dir=$plugins_dir/tmux-adaptive-theme
workbench_core=$xdg_data_home/tmux-agent-workbench/bin/tmux-agent-workbench-core

usage()
{
  printf '%s\n' 'usage: tmux-workbench-update [--check]'
  printf '%s\n' '  --check  fetch and report available updates without applying them'
}

die()
{
  printf 'tmux-workbench-update: %s\n' "$*" >&2
  exit 1
}

repo_label()
{
  basename "$1"
}

require_repo()
{
  repo=$1
  [ -d "$repo" ] || die "checkout is missing: $repo"
  [ "$(git -C "$repo" rev-parse --is-inside-work-tree 2>/dev/null)" = true ] ||
    die "not a Git checkout: $repo"
}

require_main_checkout()
{
  repo=$1
  branch=$(git -C "$repo" symbolic-ref --quiet --short HEAD) ||
    die "$(repo_label "$repo") checkout has a detached HEAD; use a main or master checkout"
  case $branch in
    main|master) remote_branch=$branch ;;
    upstream-main) remote_branch=main ;;
    *) die "$(repo_label "$repo") checkout is on $branch; use a separate worktree for changes" ;;
  esac
  upstream=$(git -C "$repo" rev-parse --symbolic-full-name '@{upstream}' 2>/dev/null) ||
    die "$(repo_label "$repo") $branch has no upstream; track a remote $remote_branch branch"
  case $upstream in
    refs/remotes/*/"$remote_branch") ;;
    *) die "$(repo_label "$repo") $branch tracks $upstream; track a remote $remote_branch branch" ;;
  esac
}

resolve_agent_team_checkout()
{
  # Older installations may still link the commands to a checkout outside XDG.
  # Respect explicit overrides and existing default paths, including broken links.
  if [ -n "${AGENT_TEAM_REPO:-}" ] || [ -e "$agent_team_dir" ] || [ -L "$agent_team_dir" ]; then
    return 0
  fi
  agent_team_command=$(command -v agent-team) || return 0
  installed_agent_team_dir=$(python3 -c '
from pathlib import Path
import sys
entrypoint = Path(sys.argv[1]).resolve()
repo = entrypoint.parent.parent
if (entrypoint.name == "agent-team" and entrypoint.parent.name == "bin"
        and (repo / ".git").exists() and (repo / "install.py").is_file()):
    print(repo)
' "$agent_team_command") || die 'failed to resolve installed agent-team checkout'
  [ -n "$installed_agent_team_dir" ] || return 0
  agent_team_dir=$installed_agent_team_dir
  printf 'agent-team: using installed checkout: %s\n' "$agent_team_dir"
}

run_quiet()
{
  if "$@" >"$log_file" 2>&1; then
    return 0
  fi

  cat "$log_file" >&2
  return 1
}

fetch_repo()
{
  repo=$1
  for fetch_attempt in 1 2 3; do
    if git -C "$repo" fetch --quiet --prune >"$log_file" 2>&1; then
      return 0
    fi
    if [ "$fetch_attempt" -lt 3 ]; then
      sleep 1
    fi
  done
  cat "$log_file" >&2
  die "failed to fetch $(repo_label "$repo")"
}

update_repo()
{
  repo=$1
  before=$(git -C "$repo" rev-parse HEAD)
  upstream=$(git -C "$repo" rev-parse --symbolic-full-name '@{upstream}')
  # Repositories were fetched together above; merge the fetched tracking ref
  # instead of making a second network request through git pull.
  run_quiet git -C "$repo" merge --ff-only "$upstream" ||
    die "failed to update $(repo_label "$repo")"
  after=$(git -C "$repo" rev-parse HEAD)

  if [ "$before" = "$after" ]; then
    printf '%s: up to date\n' "$(repo_label "$repo")"
  else
    printf '%s: updated\n' "$(repo_label "$repo")"
  fi
}

report_repo()
{
  repo=$1
  upstream=$(git -C "$repo" rev-parse --abbrev-ref '@{upstream}')
  counts=$(git -C "$repo" rev-list --left-right --count "HEAD...$upstream")
  ahead=$(printf '%s\n' "$counts" | awk '{print $1}')
  behind=$(printf '%s\n' "$counts" | awk '{print $2}')

  if [ -n "$(git -C "$repo" status --porcelain)" ]; then
    printf '%s: warning: local changes\n' "$(repo_label "$repo")" >&2
  elif [ "$ahead" -gt 0 ] && [ "$behind" -gt 0 ]; then
    printf '%s: diverged (+%s/-%s)\n' "$(repo_label "$repo")" "$ahead" "$behind"
  elif [ "$ahead" -gt 0 ]; then
    printf '%s: %s local commit(s) ahead\n' "$(repo_label "$repo")" "$ahead"
  elif [ "$behind" -gt 0 ]; then
    printf '%s: %s update(s) available\n' "$(repo_label "$repo")" "$behind"
  else
    printf '%s: up to date\n' "$(repo_label "$repo")"
  fi
}

repo_has_unreleased_changes()
{
  repo=$1
  upstream=$(git -C "$repo" rev-parse --abbrev-ref '@{upstream}')
  ahead=$(git -C "$repo" rev-list --count "$upstream..HEAD")

  [ -n "$(git -C "$repo" status --porcelain)" ] || [ "$ahead" -gt 0 ]
}

warn_workbench_unreleased()
{
  printf '%s\n' 'tmux-agent-workbench: warning: local/unreleased changes detected; keeping checkout and installing the latest GitHub release' >&2
}

inspect_workbench_checkout()
{
  repo=$1
  workbench_branch=$(git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null || printf '%s' 'detached HEAD')
  case $workbench_branch in
    main|master|upstream-main)
      require_main_checkout "$repo"
      workbench_development_checkout=0
      ;;
    *)
      # Plugin installations are often used as active feature checkouts. Keep
      # those branches intact and install the published release below instead.
      workbench_development_checkout=1
      ;;
  esac
}

report_workbench_repo()
{
  if [ "$workbench_development_checkout" -eq 1 ]; then
    printf 'tmux-agent-workbench: development checkout (%s); checkout will be preserved\n' "$workbench_branch"
    if [ -n "$(git -C "$workbench_dir" status --porcelain)" ]; then
      printf '%s\n' 'tmux-agent-workbench: warning: local changes' >&2
    fi
  else
    report_repo "$workbench_dir"
  fi
}

latest_workbench_release_tag()
{
  command -v curl >/dev/null 2>&1 || die 'curl is required'
  workbench_release_tmp=$(mktemp -d "${TMPDIR:-/tmp}/tmux-workbench-release.XXXXXX")
  # Reuse gh authentication instead of exhausting the shared anonymous API quota.
  # Keep the curl fallback for machines without gh or a usable GitHub login.
  if command -v gh >/dev/null 2>&1 &&
    gh api --hostname github.com 'repos/lukewang1024/tmux-agent-workbench/releases?per_page=20' \
      >"$workbench_release_tmp/releases.json" 2>"$log_file"; then
    :
  else
    run_quiet curl -fsSL --retry 3 --retry-all-errors --retry-delay 1 \
      'https://api.github.com/repos/lukewang1024/tmux-agent-workbench/releases?per_page=20' \
      -o "$workbench_release_tmp/releases.json" ||
      die 'failed to list tmux-agent-workbench releases; if the GitHub API is rate-limited, authenticate with gh auth login'
  fi
  workbench_release_tag=$(python3 -c '
import json, re, sys
with open(sys.argv[1], encoding="utf-8") as source:
    releases = json.load(source)
published = [item for item in releases if not item.get("draft") and item.get("published_at")]
if not published:
    raise SystemExit("no published tmux-agent-workbench release")
tag = max(published, key=lambda item: item["published_at"])["tag_name"]
if not re.fullmatch(r"v[0-9][A-Za-z0-9._-]*", tag):
    raise SystemExit("invalid tmux-agent-workbench release tag")
print(tag)
' "$workbench_release_tmp/releases.json") || die 'failed to select tmux-agent-workbench release'
}

workbench_release_target()
{
  android=0
  [ -z "${TERMUX_VERSION:-}" ] || android=1
  case ${PREFIX:-} in /data/data/com.termux/*) android=1 ;; esac
  case $(uname -o 2>/dev/null || true) in Android) android=1 ;; esac
  if [ "$android" -eq 1 ]; then
    case $(uname -m) in
      aarch64|arm64) printf '%s\n' aarch64-linux-android ;;
      x86_64|amd64) printf '%s\n' x86_64-linux-android ;;
      *) return 1 ;;
    esac
  else
    case "$(uname -s)-$(uname -m)" in
      Darwin-arm64) printf '%s\n' aarch64-apple-darwin ;;
      Darwin-x86_64) printf '%s\n' x86_64-apple-darwin ;;
      Linux-aarch64|Linux-arm64) printf '%s\n' aarch64-unknown-linux-gnu ;;
      Linux-x86_64) printf '%s\n' x86_64-unknown-linux-musl ;;
      Linux-i686) printf '%s\n' i586-unknown-linux-musl ;;
      *) return 1 ;;
    esac
  fi
}

install_workbench_release()
{
  tag=$1
  installed_version=
  if [ -x "$workbench_core" ]; then
    installed_version=$("$workbench_core" --version 2>/dev/null | awk '{print $2}')
  fi
  [ "$installed_version" != "${tag#v}" ] || return 0

  target=$(workbench_release_target) || die 'no tmux-agent-workbench release asset for this platform'
  archive=$workbench_release_tmp/archive.tar.gz
  url="https://github.com/lukewang1024/tmux-agent-workbench/releases/download/$tag/tmux-agent-workbench-$target.tar.gz"
  run_quiet curl -fsSL --retry 3 --retry-all-errors --retry-delay 1 "$url" -o "$archive" ||
    die "failed to download tmux-agent-workbench $tag"
  run_quiet tar -xzf "$archive" -C "$workbench_release_tmp" || die 'failed to unpack tmux-agent-workbench release'
  release_binary=$workbench_release_tmp/tmux-agent-workbench
  [ -x "$release_binary" ] || die 'tmux-agent-workbench release binary is missing'
  release_version=$("$release_binary" --version | awk '{print $2}')
  [ "$release_version" = "${tag#v}" ] || die "tmux-agent-workbench release version mismatch: $release_version"
  mkdir -p "$(dirname "$workbench_core")"
  workbench_core_stage=$workbench_core.new.$$
  run_quiet cp "$release_binary" "$workbench_core_stage" || die 'failed to stage tmux-agent-workbench release'
  chmod 755 "$workbench_core_stage"
  if [ "$(uname -s)" = Darwin ]; then
    run_quiet codesign --force --sign - "$workbench_core_stage" || die 'failed to sign tmux-agent-workbench release'
  fi
  mv -f "$workbench_core_stage" "$workbench_core"
  workbench_core_stage=
  printf 'tmux-workbench-update: installed tmux-agent-workbench %s\n' "$tag"
}

mode=update
case ${1:-} in
  '') ;;
  --check) mode=check ;;
  -h|--help) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac

command -v git >/dev/null 2>&1 || die 'git is required'
command -v python3 >/dev/null 2>&1 || die 'python3 is required'
resolve_agent_team_checkout

# Check every checkout before changing any of them. Dotfiles, agent-team and
# the theme use their main installation branches. A Workbench plugin checkout
# on another branch is preserved while the published core release is installed.
# upstream-main is a maintenance alias that preserves a local development main.
for repo in "$dotfiles_dir" "$agent_team_dir" "$workbench_dir" "$theme_dir"; do
  require_repo "$repo"
  if [ "$repo" = "$workbench_dir" ]; then
    inspect_workbench_checkout "$repo"
  else
    require_main_checkout "$repo"
  fi
done

printf '%s\n' 'tmux-workbench-update: fetching repositories'
for repo in "$dotfiles_dir" "$agent_team_dir" "$workbench_dir" "$theme_dir"; do
  fetch_repo "$repo"
done
latest_workbench_release_tag

if [ "$mode" = check ]; then
  printf '%s\n' 'tmux-workbench-update: checking updates'
  report_repo "$dotfiles_dir"
  report_repo "$agent_team_dir"
  report_workbench_repo
  report_repo "$theme_dir"
  printf 'tmux-agent-workbench release: %s published\n' "$workbench_release_tag"
  exit 0
fi

printf '%s\n' 'tmux-workbench-update: updating repositories'
update_repo "$dotfiles_dir"
if repo_has_unreleased_changes "$agent_team_dir"; then
  printf '%s\n' 'agent-team: warning: local/unreleased changes detected; keeping checkout and reinstalling existing commands' >&2
else
  update_repo "$agent_team_dir"
fi
if [ "$workbench_development_checkout" -eq 1 ]; then
  printf 'tmux-agent-workbench: preserving development checkout (%s); installing the latest GitHub release\n' "$workbench_branch"
elif repo_has_unreleased_changes "$workbench_dir"; then
  warn_workbench_unreleased
else
  update_repo "$workbench_dir"
fi
update_repo "$theme_dir"

printf '%s\n' 'tmux-workbench-update: syncing dotfiles'
run_quiet "$dotfiles_dir/init" sync || die 'failed to sync dotfiles'
printf '%s\n' 'tmux-workbench-update: dotfiles synced'

printf '%s\n' 'tmux-workbench-update: installing agent-team commands'
run_quiet python3 "$agent_team_dir/install.py" --bin-dir "$bin_dir" ||
  die 'failed to install agent-team commands'
printf '%s\n' 'tmux-workbench-update: agent-team commands installed'

if [ -x "$workbench_dir/install" ]; then
  printf '%s\n' 'tmux-workbench-update: installing workbench commands'
  run_quiet env TMUX_AGENT_WORKBENCH_RELEASE_ONLY=1 TMUX_AGENT_WORKBENCH_RELEASE_TAG="$workbench_release_tag" "$workbench_dir/install" "$bin_dir" ||
    die 'failed to install tmux-agent-workbench commands'
fi
install_workbench_release "$workbench_release_tag"

# Existing daemon and sidebar processes keep the old executable mapped after
# it is replaced. Stop the daemon, reload the plugin, and respawn sidebar panes
# in place so their layout and window membership are preserved.
if command -v tmux >/dev/null 2>&1 && tmux list-sessions >/dev/null 2>&1; then
  printf '%s\n' 'tmux-workbench-update: reloading active tmux server'
  workbench_command=$bin_dir/tmux-agent-workbench
  if [ -x "$workbench_command" ]; then
    tmux run-shell "\"$workbench_command\" daemon stop >/dev/null 2>&1 || true"
    sleep 1
  fi
  tmux source-file "$xdg_config_home/tmux/tmux.conf"
  if [ -x "$workbench_command" ]; then
    tmux run-shell "\"$workbench_command\" daemon ensure"
    tmux list-panes -a -f '#{==:#{@pane_role},sidebar}' -F '#{pane_id}' |
      while IFS= read -r sidebar_pane; do
        [ -n "$sidebar_pane" ] || continue
        tmux respawn-pane -k -t "$sidebar_pane"
      done
    tmux run-shell "\"$workbench_command\" sidebar-control ensure-all"
  fi
  if [ -x "$theme_dir/tmux-adaptive-theme.tmux" ]; then
    "$theme_dir/tmux-adaptive-theme.tmux"
  fi
  printf '%s\n' 'tmux-workbench-update: active tmux server reloaded'
fi

# Refresh an existing login-scoped appearance watcher after installing updates.
# Leave machines that have not enabled the watcher opted out.
if [ "$(uname -s)" = Darwin ]; then
  appearance_service="gui/$(id -u)/com.lukew.appearance"
  if launchctl print "$appearance_service" >/dev/null 2>&1; then
    printf '%s\n' 'tmux-workbench-update: restarting appearance watcher'
    run_quiet launchctl kickstart -k "$appearance_service" ||
      die 'failed to restart appearance watcher'
    printf '%s\n' 'tmux-workbench-update: appearance watcher restarted'
  fi
fi

printf '%s\n' 'tmux-workbench-update: complete'
