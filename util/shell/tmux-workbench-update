#!/bin/sh

# Fast-forward the dotfiles and the two locally maintained tmux plugins, then
# re-apply their installation steps to the current machine.

set -eu

expand_home()
{
  case $1 in
    \~) printf '%s\n' "$HOME" ;;
    \~/*) printf '%s%s\n' "$HOME" "${1#\~}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

xdg_config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
xdg_data_home=${XDG_DATA_HOME:-"$HOME/.local/share"}
dotfiles_dir=${DOTFILES_DIR:-"$xdg_config_home/dotfiles"}
plugins_dir=${TMUX_PLUGIN_MANAGER_PATH:-"$xdg_data_home/tmux/plugins"}
bin_dir=${XDG_BIN_HOME:-"$HOME/.local/bin"}
xdg_config_home=$(expand_home "$xdg_config_home")
xdg_data_home=$(expand_home "$xdg_data_home")
dotfiles_dir=$(expand_home "$dotfiles_dir")
plugins_dir=$(expand_home "$plugins_dir")
bin_dir=$(expand_home "$bin_dir")
workbench_dir=$plugins_dir/tmux-agent-workbench
theme_dir=$plugins_dir/tmux-adaptive-theme

usage()
{
  printf '%s\n' 'usage: tmux-workbench-update [--check]'
  printf '%s\n' '  --check  fetch and report available updates without applying them'
}

die()
{
  printf 'tmux-workbench-update: %s\n' "$*" >&2
  exit 1
}

repo_label()
{
  basename "$1"
}

require_clean()
{
  repo=$1
  [ -d "$repo" ] || die "checkout is missing: $repo"
  [ "$(git -C "$repo" rev-parse --is-inside-work-tree 2>/dev/null)" = true ] ||
    die "not a Git checkout: $repo"
  [ -z "$(git -C "$repo" status --porcelain)" ] ||
    die "$(repo_label "$repo") has local changes; commit or stash them first"
}

fetch_repo()
{
  repo=$1
  printf 'Fetching %s...\n' "$(repo_label "$repo")"
  git -C "$repo" fetch --quiet --prune
}

update_repo()
{
  repo=$1
  printf 'Updating %s...\n' "$(repo_label "$repo")"
  git -C "$repo" pull --ff-only
}

report_repo()
{
  repo=$1
  upstream=$(git -C "$repo" rev-parse --abbrev-ref '@{upstream}' 2>/dev/null) ||
    die "$(repo_label "$repo") has no upstream branch"
  counts=$(git -C "$repo" rev-list --left-right --count "HEAD...$upstream")
  behind=$(printf '%s\n' "$counts" | awk '{print $2}')
  printf '%-24s %s commit(s) available\n' "$(repo_label "$repo")" "$behind"
}

mode=update
case ${1:-} in
  '') ;;
  --check) mode=check ;;
  -h|--help) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac

command -v git >/dev/null 2>&1 || die 'git is required'

# Check every checkout before changing any of them. This avoids a half-updated
# stack when one TPM plugin contains an experiment or other local work.
for repo in "$dotfiles_dir" "$workbench_dir" "$theme_dir"; do
  require_clean "$repo"
done

if [ "$mode" = check ]; then
  for repo in "$dotfiles_dir" "$workbench_dir" "$theme_dir"; do
    fetch_repo "$repo"
    report_repo "$repo"
  done
  exit 0
fi

update_repo "$dotfiles_dir"
update_repo "$workbench_dir"
update_repo "$theme_dir"

# Reconcile links/config after dotfiles changes, then refresh commands exported
# by the workbench plugin. Both operations are idempotent.
"$dotfiles_dir/init" sync
if [ -x "$workbench_dir/install" ]; then
  # A source update does not necessarily bump Cargo.toml's version. Build first
  # when Cargo is available so install cannot mistake an older same-version
  # binary for the current checkout.
  if command -v cargo >/dev/null 2>&1; then
    cargo build --quiet --manifest-path "$workbench_dir/Cargo.toml" \
      --release --bin tmux-agent-workbench
  fi
  "$workbench_dir/install" "$bin_dir"
fi

# Existing daemon and sidebar processes keep the old executable mapped after
# it is replaced. Stop the daemon, reload the plugin, and respawn sidebar panes
# in place so their layout and window membership are preserved.
if command -v tmux >/dev/null 2>&1 && tmux list-sessions >/dev/null 2>&1; then
  workbench_command=$bin_dir/tmux-agent-workbench
  if [ -x "$workbench_command" ]; then
    tmux run-shell "\"$workbench_command\" daemon stop >/dev/null 2>&1 || true"
    sleep 1
  fi
  tmux source-file "$xdg_config_home/tmux/tmux.conf"
  if [ -x "$workbench_command" ]; then
    tmux run-shell "\"$workbench_command\" daemon ensure"
    tmux list-panes -a -f '#{==:#{@pane_role},sidebar}' -F '#{pane_id}' |
      while IFS= read -r sidebar_pane; do
        [ -n "$sidebar_pane" ] || continue
        tmux respawn-pane -k -t "$sidebar_pane"
      done
    tmux run-shell "\"$workbench_command\" sidebar-control ensure-all"
  fi
  if [ -x "$theme_dir/tmux-adaptive-theme.tmux" ]; then
    "$theme_dir/tmux-adaptive-theme.tmux"
  fi
  printf '%s\n' 'Reloaded the active tmux server.'
fi

printf '%s\n' 'tmux workbench stack is up to date.'
