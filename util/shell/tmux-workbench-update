#!/bin/sh

# Fast-forward the dotfiles and the two locally maintained tmux plugins, then
# re-apply their installation steps to the current machine.

set -eu

log_file=$(mktemp "${TMPDIR:-/tmp}/tmux-workbench-update.XXXXXX")

cleanup()
{
  rm -f "$log_file"
}

trap cleanup 0 1 2 3 15

expand_home()
{
  case $1 in
    \~) printf '%s\n' "$HOME" ;;
    \~/*) printf '%s%s\n' "$HOME" "${1#\~}" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

xdg_config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
xdg_data_home=${XDG_DATA_HOME:-"$HOME/.local/share"}
dotfiles_dir=${DOTFILES_DIR:-"$xdg_config_home/dotfiles"}
plugins_dir=${TMUX_PLUGIN_MANAGER_PATH:-"$xdg_data_home/tmux/plugins"}
bin_dir=${XDG_BIN_HOME:-"$HOME/.local/bin"}
xdg_config_home=$(expand_home "$xdg_config_home")
xdg_data_home=$(expand_home "$xdg_data_home")
dotfiles_dir=$(expand_home "$dotfiles_dir")
plugins_dir=$(expand_home "$plugins_dir")
bin_dir=$(expand_home "$bin_dir")
workbench_dir=$plugins_dir/tmux-agent-workbench
theme_dir=$plugins_dir/tmux-adaptive-theme

usage()
{
  printf '%s\n' 'usage: tmux-workbench-update [--check]'
  printf '%s\n' '  --check  fetch and report available updates without applying them'
}

die()
{
  printf 'tmux-workbench-update: %s\n' "$*" >&2
  exit 1
}

repo_label()
{
  basename "$1"
}

require_repo()
{
  repo=$1
  [ -d "$repo" ] || die "checkout is missing: $repo"
  [ "$(git -C "$repo" rev-parse --is-inside-work-tree 2>/dev/null)" = true ] ||
    die "not a Git checkout: $repo"
}

run_quiet()
{
  if "$@" >"$log_file" 2>&1; then
    return 0
  fi

  cat "$log_file" >&2
  return 1
}

fetch_repo()
{
  repo=$1
  run_quiet git -C "$repo" fetch --quiet --prune ||
    die "failed to fetch $(repo_label "$repo")"
}

update_repo()
{
  repo=$1
  before=$(git -C "$repo" rev-parse HEAD)
  run_quiet git -C "$repo" pull --ff-only ||
    die "failed to update $(repo_label "$repo")"
  after=$(git -C "$repo" rev-parse HEAD)

  if [ "$before" = "$after" ]; then
    printf '%s: up to date\n' "$(repo_label "$repo")"
  else
    printf '%s: updated\n' "$(repo_label "$repo")"
  fi
}

report_repo()
{
  repo=$1
  upstream=$(git -C "$repo" rev-parse --abbrev-ref '@{upstream}' 2>/dev/null) ||
    die "$(repo_label "$repo") has no upstream branch"
  counts=$(git -C "$repo" rev-list --left-right --count "HEAD...$upstream")
  ahead=$(printf '%s\n' "$counts" | awk '{print $1}')
  behind=$(printf '%s\n' "$counts" | awk '{print $2}')

  if [ -n "$(git -C "$repo" status --porcelain)" ]; then
    printf '%s: warning: local changes\n' "$(repo_label "$repo")" >&2
  elif [ "$ahead" -gt 0 ] && [ "$behind" -gt 0 ]; then
    printf '%s: diverged (+%s/-%s)\n' "$(repo_label "$repo")" "$ahead" "$behind"
  elif [ "$ahead" -gt 0 ]; then
    printf '%s: %s local commit(s) ahead\n' "$(repo_label "$repo")" "$ahead"
  elif [ "$behind" -gt 0 ]; then
    printf '%s: %s update(s) available\n' "$(repo_label "$repo")" "$behind"
  else
    printf '%s: up to date\n' "$(repo_label "$repo")"
  fi
}

workbench_has_unreleased_changes()
{
  repo=$1
  upstream=$(git -C "$repo" rev-parse --abbrev-ref '@{upstream}')
  ahead=$(git -C "$repo" rev-list --count "$upstream..HEAD")

  [ -n "$(git -C "$repo" status --porcelain)" ] || [ "$ahead" -gt 0 ]
}

warn_workbench_unreleased()
{
  printf '%s\n' 'tmux-agent-workbench: warning: local/unreleased changes detected; keeping checkout and installing the latest GitHub release' >&2
}

mode=update
case ${1:-} in
  '') ;;
  --check) mode=check ;;
  -h|--help) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac

command -v git >/dev/null 2>&1 || die 'git is required'

# Check every checkout before changing any of them. The workbench checkout is
# allowed to contain experiments: those are reported and never built here.
for repo in "$dotfiles_dir" "$workbench_dir" "$theme_dir"; do
  require_repo "$repo"
done

printf '%s\n' 'tmux-workbench-update: fetching repositories'
for repo in "$dotfiles_dir" "$workbench_dir" "$theme_dir"; do
  fetch_repo "$repo"
done

if [ "$mode" = check ]; then
  printf '%s\n' 'tmux-workbench-update: checking updates'
  for repo in "$dotfiles_dir" "$workbench_dir" "$theme_dir"; do
    report_repo "$repo"
  done
  exit 0
fi

printf '%s\n' 'tmux-workbench-update: updating repositories'
update_repo "$dotfiles_dir"
if workbench_has_unreleased_changes "$workbench_dir"; then
  warn_workbench_unreleased
else
  update_repo "$workbench_dir"
fi
update_repo "$theme_dir"

printf '%s\n' 'tmux-workbench-update: syncing dotfiles'
run_quiet "$dotfiles_dir/init" sync || die 'failed to sync dotfiles'
printf '%s\n' 'tmux-workbench-update: dotfiles synced'

if [ -x "$workbench_dir/install" ]; then
  printf '%s\n' 'tmux-workbench-update: installing latest GitHub release'
  run_quiet env TMUX_AGENT_WORKBENCH_RELEASE_ONLY=1 "$workbench_dir/install" "$bin_dir" ||
    die 'failed to install the latest tmux-agent-workbench GitHub release'
fi

# Existing daemon and sidebar processes keep the old executable mapped after
# it is replaced. Stop the daemon, reload the plugin, and respawn sidebar panes
# in place so their layout and window membership are preserved.
if command -v tmux >/dev/null 2>&1 && tmux list-sessions >/dev/null 2>&1; then
  printf '%s\n' 'tmux-workbench-update: reloading active tmux server'
  workbench_command=$bin_dir/tmux-agent-workbench
  if [ -x "$workbench_command" ]; then
    tmux run-shell "\"$workbench_command\" daemon stop >/dev/null 2>&1 || true"
    sleep 1
  fi
  tmux source-file "$xdg_config_home/tmux/tmux.conf"
  if [ -x "$workbench_command" ]; then
    tmux run-shell "\"$workbench_command\" daemon ensure"
    tmux list-panes -a -f '#{==:#{@pane_role},sidebar}' -F '#{pane_id}' |
      while IFS= read -r sidebar_pane; do
        [ -n "$sidebar_pane" ] || continue
        tmux respawn-pane -k -t "$sidebar_pane"
      done
    tmux run-shell "\"$workbench_command\" sidebar-control ensure-all"
  fi
  if [ -x "$theme_dir/tmux-adaptive-theme.tmux" ]; then
    "$theme_dir/tmux-adaptive-theme.tmux"
  fi
  printf '%s\n' 'tmux-workbench-update: active tmux server reloaded'
fi

printf '%s\n' 'tmux-workbench-update: complete'
