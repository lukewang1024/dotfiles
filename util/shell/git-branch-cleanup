#!/bin/sh
# git-branch-cleanup - Clean up branches already integrated into the current (or specified) ref
# Recognizes fast-forward / merge-commit integration (safe `git branch -d`) AND
# content-level integration that leaves no topological trace: squash merges,
# rebase merges, and "merged upstream then locally merged a stale base" cases.
# Content-merged branches are force-deleted (`git branch -D`) and reported separately.
#
# Usage: git-branch-cleanup [ref] [--dry-run]

set -eu

ref=""
dry_run=0
for arg in "$@"; do
    case "$arg" in
        --dry-run|-n) dry_run=1 ;;
        *) ref=$arg ;;
    esac
done
[ -n "$ref" ] || ref=$(git branch --show-current)

# Branches checked out in a worktree can't be deleted; collect for skip/lookup.
worktree_branches=$(git worktree list --porcelain | sed -n 's|^branch refs/heads/||p')

# is_content_merged BRANCH — true if BRANCH's changes are already present in $ref
# even when its tip is not an ancestor (squash / rebase / stale-merge).
is_content_merged() {
    _b=$1
    _mb=$(git merge-base "$ref" "$_b" 2>/dev/null) || return 1

    # Squash detection: collapse the whole branch into one synthetic commit on the
    # merge-base and ask whether that combined patch already exists in $ref.
    _tree=$(git rev-parse "$_b^{tree}")
    _dangling=$(git commit-tree "$_tree" -p "$_mb" -m _)
    case "$(git cherry "$ref" "$_dangling")" in
        "") return 0 ;;   # empty diff over merge-base = nothing to merge
        -*) return 0 ;;   # combined patch already in $ref (squash / stale-merge)
    esac

    # Rebase detection: every individual branch commit's patch is already in $ref
    # (rebase preserves per-commit patch-ids; the squash check above would miss it).
    _cherry=$(git cherry "$ref" "$_b")
    if [ -n "$_cherry" ] && ! printf '%s\n' "$_cherry" | grep -q '^+'; then
        return 0
    fi
    return 1
}

deleted=""            ; n_deleted=0
soft_deleted=""       ; n_soft=0
skipped_worktree=""   ; n_wt=0
skipped_unmerged=""   ; n_unmerged=0

for branch in $(git for-each-ref --format='%(refname:short)' refs/heads/); do
    [ "$branch" = "$ref" ] && continue

    if printf '%s\n' "$worktree_branches" | grep -qx "$branch"; then
        skipped_worktree="${skipped_worktree}  ${branch}
"
        n_wt=$((n_wt + 1))
        continue
    fi

    # Fast path: safe delete for topologically-merged branches.
    if [ "$dry_run" -eq 0 ] && err=$(git branch -d "$branch" 2>&1); then
        deleted="${deleted}  ${branch}
"
        n_deleted=$((n_deleted + 1))
        continue
    fi
    if [ "$dry_run" -eq 1 ] && git merge-base --is-ancestor "$branch" "$ref" 2>/dev/null; then
        deleted="${deleted}  ${branch}
"
        n_deleted=$((n_deleted + 1))
        continue
    fi

    # Not an ancestor: fall back to content-level detection.
    if is_content_merged "$branch"; then
        if [ "$dry_run" -eq 1 ]; then
            soft_deleted="${soft_deleted}  ${branch}  (would force-delete)
"
        else
            git branch -D "$branch" >/dev/null
            soft_deleted="${soft_deleted}  ${branch}
"
        fi
        n_soft=$((n_soft + 1))
    else
        skipped_unmerged="${skipped_unmerged}  ${branch}
"
        n_unmerged=$((n_unmerged + 1))
    fi
done

plural() { [ "$1" -eq 1 ] && echo "branch" || echo "branches"; }
[ "$dry_run" -eq 1 ] && echo "(dry-run — nothing deleted)"

if [ $n_deleted -gt 0 ]; then
    echo "Deleted $n_deleted $(plural $n_deleted):"
    printf '%s' "$deleted"
fi
if [ $n_soft -gt 0 ]; then
    echo "Force-deleted $n_soft $(plural $n_soft) (content already in '$ref' via squash/rebase/stale-merge):"
    printf '%s' "$soft_deleted"
fi
if [ $n_wt -gt 0 ]; then
    echo "Skipped $n_wt $(plural $n_wt) (in use by worktree):"
    printf '%s' "$skipped_worktree"
fi
if [ $n_unmerged -gt 0 ]; then
    echo "Skipped $n_unmerged $(plural $n_unmerged) (not merged — has unique work):"
    printf '%s' "$skipped_unmerged"
fi
if [ $((n_deleted + n_soft + n_wt + n_unmerged)) -eq 0 ]; then
    echo "No branches to clean up."
fi
