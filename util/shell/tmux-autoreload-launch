#!/bin/sh
# One config watcher per tmux server, owned by a connection to that server.
# Unlike a detached plugin watcher, this exits with temporary test servers too.
set -u
command -v entr >/dev/null 2>&1 || exit 0

socket=$(tmux display-message -p '#{socket_path}') || exit 0
[ -n "$socket" ] || exit 0
option=@dotfiles-autoreload-pid
lock=dotfiles-autoreload-start
tmux -S "$socket" wait-for -L "$lock" || exit 0
owner=$(tmux -S "$socket" show-options -gv "$option" 2>/dev/null) || owner=
case "$owner" in
  ''|*[!0-9]*) ;;
  *) if kill -0 "$owner" 2>/dev/null; then
       tmux -S "$socket" wait-for -U "$lock"
       exit 0
     fi ;;
esac

watcher=
connection=
cleanup() {
  trap - EXIT HUP INT TERM
  [ -z "$watcher" ] || kill "$watcher" 2>/dev/null || :
  [ -z "$connection" ] || kill "$connection" 2>/dev/null || :
  wait 2>/dev/null || :
  owner=$(tmux -S "$socket" show-options -gv "$option" 2>/dev/null) || owner=
  if [ "$owner" = "$$" ]; then
    tmux -S "$socket" set-option -gu "$option" 2>/dev/null || :
  fi
}
trap cleanup EXIT
trap 'exit 0' HUP INT TERM
tmux -S "$socket" set-option -g "$option" "$$" || exit 0
tmux -S "$socket" wait-for -U "$lock" || exit 0
configs=$(tmux -S "$socket" display-message -p '#{config_files}') || exit 0
[ -n "$configs" ] || exit 0

# A wait-for client disconnects when its server exits. Keep its PID so signals
# to this launcher also terminate the connection and watcher immediately.
tmux -S "$socket" wait-for "dotfiles-autoreload-lifetime-$$" &
connection=$!
# Arguments are expanded by the child shell.
# shellcheck disable=SC2016
printf '%s\n' "$configs" | tr ',' '\n' |
  entr -np sh -c 'tmux -S "$1" source-file "$2"' sh "$socket" /_ &
watcher=$!
wait "$connection" 2>/dev/null || :
