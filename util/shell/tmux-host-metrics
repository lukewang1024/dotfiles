#!/bin/sh
# Host metrics for tmux. No daemon/sleep; counter deltas use the previous refresh.
# Android may deny /proc counters: report -- rather than inventing zero usage.
export LC_ALL=C
export PATH="$PATH:/usr/sbin:/sbin:/usr/bin:/bin"
umask 077
metrics_cache="${XDG_CACHE_HOME:-$HOME/.cache}/tmux-host-metrics"
mkdir -p "$metrics_cache" || exit 1
mode=${1:-full}
case "$mode" in full|cpu) ;; *) exit 2 ;; esac
now=$(date +%s)
# Atomic directory lock prevents simultaneous status clients racing snapshots.
if [ -r "$metrics_cache/lock/pid" ]; then
  lock_pid=$(cat "$metrics_cache/lock/pid" 2>/dev/null)
  case "$lock_pid" in
    ''|*[!0-9]*) ;;
    *) if ! kill -0 "$lock_pid" 2>/dev/null; then
         rm -f "$metrics_cache/lock/pid"
         rmdir "$metrics_cache/lock" 2>/dev/null
       fi ;;
  esac
fi
if ! mkdir "$metrics_cache/lock" 2>/dev/null; then
  cat "$metrics_cache/$mode" 2>/dev/null
  exit 0
fi
printf '%s\n' "$$" > "$metrics_cache/lock/pid"
trap 'rm -f "$metrics_cache/lock/pid"; rmdir "$metrics_cache/lock" 2>/dev/null' 0
trap 'exit 1' HUP INT TERM
previous_time=$(cat "$metrics_cache/time" 2>/dev/null)
case "$previous_time" in ''|*[!0-9]*) previous_time=0 ;; esac
if [ "$((now - previous_time))" -ge 0 ] && [ "$((now - previous_time))" -lt 2 ]; then
  cat "$metrics_cache/$mode" 2>/dev/null
  exit 0
fi
cpu=-- mem=-- disk=-- rx='' tx='' iface='' total='' idle='' sampled_rx='' sampled_tx=''
proc_root=${TMUX_METRICS_PROC_ROOT:-/proc}
case "$(uname -s)" in
  Darwin)
    cpu=$(top -l 1 -n 0 2>/dev/null | awk '/CPU usage:/ {gsub(/%/, "", $(NF-1)); printf "%.0f%%", 100-$(NF-1); exit}')
    mem=$(vm_stat 2>/dev/null | awk -v total="$(sysctl -n hw.memsize 2>/dev/null)" '
      /page size of/ {page=$8}
      /Pages active:/ {active=$NF+0}
      /Pages wired down:/ {wired=$NF+0}
      /Pages occupied by compressor:/ {compressed=$NF+0}
      END {if(total>0 && page>0) printf "%.0f%%", 100*(active+wired+compressed)*page/total}')
    # Some macOS drivers leave netstat Ibytes frozen. Network Statistics
    # provides live TCP/UDP deltas; exclude loopback and count summaries once.
    # Two samples delimit a one-second interval; the first is cumulative.
    counters=$(nettop -n -P -L 2 -s 1 -d -x -t external -J bytes_in,bytes_out 2>/dev/null | awk -F, '
      $1=="" {sample++; next}
      sample==2 && $2 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ {rx+=$2; tx+=$3; found=1}
      END {if(found) printf "%.0f %.0f\n", rx, tx}')
    read -r sampled_rx sampled_tx <<EOF
$counters
EOF
    ;;
  Linux)
    counters=$(awk '/^cpu / {sum=0; for(i=2;i<=9;i++)sum+=$i; printf "%.0f %.0f\n", sum, $5+$6; exit}' "$proc_root/stat" 2>/dev/null)
    read -r total idle <<EOF
$counters
EOF
    mem=$(awk '/^MemTotal:/ {total=$2} /^MemAvailable:/ {avail=$2; found=1}
      END {if(total>0 && found) printf "%.0f%%", 100*(total-avail)/total}' "$proc_root/meminfo" 2>/dev/null)
    iface=$(awk '$2=="00000000" && $8=="00000000" {if(!found || $7<metric) {iface=$1; metric=$7; found=1}} END {print iface}' "$proc_root/net/route" 2>/dev/null)
    if [ -z "$iface" ]; then
      iface=$(ip -o route show default 2>/dev/null | awk '{for(i=1;i<NF;i++) if($i=="dev") {print $(i+1); exit}}')
    fi
    if [ -n "$iface" ]; then
      counters=$(awk -F '[: ]+' -v iface="$iface" '$2==iface {print $3, $11; exit} $1==iface {print $2, $10; exit}' "$proc_root/net/dev" 2>/dev/null)
      read -r rx tx <<EOF
$counters
EOF
    fi
    ;;
esac
disk=$(df -Pk "${TMUX_METRICS_DISK_PATH:-$HOME}" 2>/dev/null | awk 'NR>1 {value=$(NF-1)} END {if(value ~ /^[0-9]+%$/) print value}')
[ -n "$cpu" ] || cpu=--
[ -n "$mem" ] || mem=--
[ -n "$disk" ] || disk=--
# Snapshot fields are data only (never sourced as shell code).
previous=$(cat "$metrics_cache/counters" 2>/dev/null)
values=$(awk -v now="$now" -v iface="$iface" -v rx="$rx" -v tx="$tx" -v total="$total" -v idle="$idle" -v sampled_rx="$sampled_rx" -v sampled_tx="$sampled_tx" '
  function numeric(v) {return v ~ /^[0-9]+$/}
  function speed(v) {
    v/=1000000
    if(v>=999.995) return ">999MB/s"
    return sprintf("%.2fMB/s", v)
  }
  BEGIN {cpu="--"; up="--"; down="--"}
  {dt=now-$1
   if(dt>0 && dt<=120 && numeric(total) && numeric(idle) && numeric($5) && numeric($6) && total>$5 && idle>=$6 && idle-$6<=total-$5)
     cpu=sprintf("%.0f%%",100*(1-(idle-$6)/(total-$5)))
   if(dt>0 && dt<=120 && iface==$2 && numeric(rx) && numeric(tx) && numeric($3) && numeric($4) && rx>=$3 && tx>=$4) {
     down=speed((rx-$3)/dt); up=speed((tx-$4)/dt)
   }}
  END {
    if(numeric(sampled_rx) && numeric(sampled_tx)) {
      down=speed(sampled_rx); up=speed(sampled_tx)
    }
    print cpu, up, down
  }' <<EOF
$previous
EOF
)
read -r sampled_cpu up down <<EOF
$values
EOF
[ -z "$total" ] || cpu=$sampled_cpu
printf '%s %s %s %s %s %s\n' "$now" "${iface:--}" "${rx:--}" "${tx:--}" "${total:--}" "${idle:--}" > "$metrics_cache/counters"
# Fixed ASCII value columns: percentages 4, speeds 10 (including units).
# Precision caps also prevent unexpected values from widening the status bar.
# Nerd Fonts: oct-cpu, md-memory, md-harddisk, md-upload, md-download.
printf ' %4.4s' "$cpu" > "$metrics_cache/cpu.tmp"
printf ' %4.4s  󰍛 %4.4s  󰋊 %4.4s  󰕒 %10.10s  󰇚 %10.10s' "$cpu" "$mem" "$disk" "$up" "$down" > "$metrics_cache/full.tmp"
mv "$metrics_cache/cpu.tmp" "$metrics_cache/cpu"
mv "$metrics_cache/full.tmp" "$metrics_cache/full"
printf '%s\n' "$now" > "$metrics_cache/time"
cat "$metrics_cache/$mode"
