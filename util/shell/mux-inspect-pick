#!/bin/sh
# mux-inspect-pick — fzf-tmux picker over your directory universe, then open the
# chosen dir as an inspection window in the current task session and focus it.
# Bound to prefix+G. The manual counterpart to the agent-driven mux-inspect.
#
# Mirrors sesh-connect's breadth and popup style, but selects a DIRECTORY (not a
# session): an inspection window is a dir, so we skip sesh's tmux-session source
# and keep the directory sources — the same ones prefix+T shows under ^x/^g/^f:
#   default  zoxide history + curated tmuxinator pool roots (deduped, abs paths)
#   ^x       zoxide only     ^g pool only     ^f find under ~
# Every candidate is an absolute path, so the pick feeds straight to mux-inspect.
#
# For Claude we can grow write scope at runtime, so nudge the agent window to
# /add-dir the picked repo. codex/opencode can't add mid-session (codex reads it
# anyway; opencode will prompt on first touch), so we skip the nudge for them.
set -eu

DEST="${XDG_CONFIG_HOME:-$HOME/.config}/tmuxinator"

# Curated pool roots from the generated tmuxinator configs (absolute paths).
pool() { grep -h '^root:' "$DEST"/*.yml 2>/dev/null | sed 's/^root:[[:space:]]*//' | grep '^/'; }
# zoxide frecency history — the bulk of the breadth (falls back to empty).
zox()  { zoxide query -l 2>/dev/null || true; }
# Combined default view: pool first (curated), then zoxide, deduped, order kept.
all()  { { pool; zox; } | awk 'NF && !seen[$0]++'; }

# Internal: fzf's reload bindings re-invoke us to swap the candidate source.
if [ "${1:-}" = "--_src" ]; then
  case "${2:-all}" in all) all ;; zox) zox ;; pool) pool ;; esac
  exit 0
fi

[ -n "${TMUX:-}" ] || { echo "mux-inspect-pick: not inside tmux" >&2; exit 1; }

sel=$(
  all | fzf-tmux -p 80%,70% --no-sort --ansi \
    --border-label ' inspect dir ' --prompt '🔍  ' \
    --header '^a all ^x zoxide ^g pool ^f find' \
    --bind 'tab:down,btab:up' \
    --bind 'ctrl-a:change-prompt(🔍  )+reload(mux-inspect-pick --_src all)' \
    --bind 'ctrl-x:change-prompt(📁  )+reload(mux-inspect-pick --_src zox)' \
    --bind 'ctrl-g:change-prompt(⚙️  )+reload(mux-inspect-pick --_src pool)' \
    --bind 'ctrl-f:change-prompt(🔎  )+reload(fd -H -d 4 -t d -E .Trash . ~)' \
    --preview-window 'right:55%' \
    --preview 'git -C {} log --oneline -20 2>/dev/null || ls -la {}'
) || exit 0
[ -n "$sel" ] || exit 0

mux-inspect "$sel" --focus

if [ "${MUX_AGENT:-claude}" = claude ] && tmux list-windows -F '#W' | grep -qx agent; then
  tmux send-keys -t agent "/add-dir $sel" Enter
fi
