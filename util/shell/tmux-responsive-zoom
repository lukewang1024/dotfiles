#!/bin/sh
# Keep responsive zoom symmetric without undoing zooms initiated by the user.

set -eu

[ "$#" -eq 2 ] || exit 2
client_width=$1
window=$2

case $client_width:$window in
  *[!0-9]*:*|*:*[!@0-9]*) exit 2 ;;
esac

sidebar_width=$(tmux show-option -gvq @sidebar_width)
main_min_width=$(tmux show-option -gvq @sidebar_main_min_width)
case $sidebar_width:$main_min_width in
  *[!0-9]*:*|*:*[!0-9]*) exit 1 ;;
esac
threshold=$((sidebar_width + main_min_width + 1))

zoomed=$(tmux display-message -pt "$window" '#{window_zoomed_flag}')
auto_zoom=$(tmux show-option -wvq -t "$window" @responsive_auto_zoom)
pane=$(tmux display-message -pt "$window" '#{pane_id}')

if [ "$client_width" -lt "$threshold" ]; then
  if [ "$zoomed" != 1 ]; then
    tmux set-option -wq -t "$window" @responsive_auto_zoom 1
    tmux resize-pane -Z -t "$pane"
  fi
elif [ "$auto_zoom" = 1 ]; then
  if [ "$zoomed" = 1 ]; then
    tmux resize-pane -Z -t "$pane"
  fi
  tmux set-option -wqu -t "$window" @responsive_auto_zoom
fi
