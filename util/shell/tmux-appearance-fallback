#!/bin/sh
# tmux-appearance-fallback light|dark|auto — OS-appearance fallback that drives
# tmux-adaptive-theme for terminals WITHOUT native theme reporting (DEC mode
# 2031), e.g. Apple Terminal.app and older clients.
#
# Wiring: the login-scoped appearance-daemon invokes this with `all` on every
# macOS light/dark switch. That replaces the old permanent watcher per tmux
# server. tmux's session-created hook invokes the single-server form for a
# server that starts after the most recent appearance change.
#
# Why the guard: dark-notify is OS-truth, but the native client-*-theme hooks are
# terminal-truth (they follow the terminal's ACTUAL theme, which may be pinned
# against the OS). If any attached client
# reports a native theme, that path is authoritative and we do nothing, so a
# 2031-capable terminal is never double-driven / flip-flopped by the OS signal.
# Only when no client reports a theme (all non-2031) do we apply the OS mode.
#
# POSIX sh — appearance-daemon's callback runs in a minimal environment.
set -u
case "${1:-}" in
   light|dark) want=$1 ;;
   auto)
      # At initial tmux startup dark-notify may publish its callback before the
      # first session exists. Resolve macOS directly once session-created fires,
      # avoiding that race. Elsewhere reuse the last published appearance.
      if command -v defaults >/dev/null 2>&1; then
         if defaults read -g AppleInterfaceStyle 2>/dev/null | grep -qi dark; then
            want=dark
         else
            want=light
         fi
      else
         state=${XDG_STATE_HOME:-"$HOME/.local/state"}/appearance
         want=$(sed -n '1p' "$state" 2>/dev/null || true)
         case "$want" in
            light|dark) ;;
            *)
               exec "$HOME/.local/share/tmux/plugins/tmux-adaptive-theme/tmux-adaptive-theme.tmux"
               ;;
         esac
      fi
      ;;
   *) printf 'usage: %s light|dark|auto\n' "$0" >&2; exit 2 ;;
esac
command -v tmux >/dev/null 2>&1 || exit 0

if [ "${2:-}" = all ]; then
   # launchd has no TMUX environment. Discover every standard local socket and
   # run the guarded single-server path against each one. The synthetic TMUX
   # value makes all nested tmux calls, including set-appearance.sh, use that
   # socket without teaching those helpers a second -S calling convention.
   for dir in "${TMUX_TMPDIR:-}" /tmp; do
      [ -n "$dir" ] || continue
      socket_dir=$dir/tmux-$(id -u)
      [ -d "$socket_dir" ] || continue
      for socket in "$socket_dir"/*; do
         [ -S "$socket" ] || continue
         TMUX="$socket,0,0" "$0" "$want" || true
      done
      break
   done
   exit 0
fi

tmux has-session >/dev/null 2>&1 || exit 0

# Defer to native mode-2031 reporting when present.
if [ -n "$(tmux list-clients -F '#{client_theme}' 2>/dev/null | tr -d '[:space:]')" ]; then
   exit 0
fi

exec "$HOME/.local/share/tmux/plugins/tmux-adaptive-theme/set-appearance.sh" "$want"
