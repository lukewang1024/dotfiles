#!/bin/sh
# theme-push-remotes light|dark — relay the local terminal's just-decided
# light/dark appearance to every SSH devbox we're currently attached to, so a
# remote tmux + nvim follow the local terminal theme without the human having to
# re-run anything on the far side.
#
# Why push a decided value instead of letting the remote probe: inside a remote
# tmux pane an OSC 11 query is answered by the remote tmux itself (its own pane
# background), not forwarded to the real terminal, and `run-shell` has no tty
# anyway. The LOCAL terminal is the one source of truth (read via OSC 11 in
# theme-sync, or reported natively via mode 2031); we ship that answer over and
# the remote just applies it — no macOS-appearance guessing on the remote.
#
# Transport prefers the peon-ping LocalForward: ~/.ssh/config.local forwards each
# box's tmux control socket to ~/.ssh/tmux-<alias>.sock, and that same socket
# lets the LOCAL tmux client drive the REMOTE tmux server in one round-trip (no
# extra ssh). We ask the remote tmux to run its OWN `theme-sync <want>`, which
# writes the remote state file and fans out remote tmux/nvim using the remote's
# native binaries — so no cross-version / no-tty issues. If the forwarded socket
# is stale or the tmux protocol is incompatible, we fall back to a short-lived
# `ssh <alias> theme-sync <want>` (same spirit as peon-ping's ssh-focus).
#
# Best-effort and bounded: every remote call runs backgrounded under a deadline
# so a wedged box never stalls the local theme switch. POSIX sh.
set -u

case "${1:-}" in
   light|dark) want=$1 ;;
   *) echo "theme-push-remotes: usage: ${0##*/} light|dark" >&2; exit 2 ;;
esac

# What the remote runs. THEME_SYNC_NO_PUSH stops the remote from trying to relay
# onward (loop-breaker). The forwarded-socket path runs this in the remote tmux
# SERVER's (login) environment, so tmux/nvim are already on PATH; the ssh
# fallback runs a NON-login shell with a bare PATH, where the remote's tmux
# (linuxbrew) would be invisible and theme-sync would fan out to "0 tmux
# servers" — writing only the state file, so nvim follows but the tmux status
# bar never repaints. Prepend the usual bin dirs so BOTH paths fan out fully;
# $HOME/$PATH stay literal here and expand on the remote. Missing dirs are inert.
remote_cmd='THEME_SYNC_NO_PUSH=1 PATH="$HOME/.local/bin:/home/linuxbrew/.linuxbrew/bin:/opt/homebrew/bin:/usr/local/bin:$PATH" "$HOME"/.local/bin/theme-sync '"$want"

# --- deadline: never let one wedged box block the fan-out ---------------------
# The forwarded socket has hung before ("no server running" after a reconnect),
# so bound every remote call. Prefer coreutils timeout; else a watchdog+kill.
if command -v timeout >/dev/null 2>&1; then
   deadline() { timeout "$@"; }
elif command -v gtimeout >/dev/null 2>&1; then
   deadline() { gtimeout "$@"; }
else
   deadline() {
      dl_secs=$1; shift
      "$@" & dl_cmd=$!
      { sleep "$dl_secs"; kill -TERM "$dl_cmd" 2>/dev/null; } & dl_watch=$!
      wait "$dl_cmd" 2>/dev/null; dl_st=$?
      kill -TERM "$dl_watch" 2>/dev/null; wait "$dl_watch" 2>/dev/null
      return "$dl_st"
   }
fi

# Workbench connections disable forwards, and mobile SSH config may contain
# desktop-only socket paths. Discover live SSH destinations as a second route.
# Report only destination and connection identity, never command contents.
records=$(python3 - <<'PYCODE'
import os
from pathlib import Path
import re
import shlex
import subprocess

targets = {}
proc = Path('/proc')
if proc.is_dir():
    rows = []
    for entry in proc.iterdir():
        if not entry.name.isdigit():
            continue
        try:
            if entry.stat().st_uid != os.getuid():
                continue
            args = [x.decode(errors='replace') for x in (entry / 'cmdline').read_bytes().split(b'\0') if x]
            rows.append((entry.name, args))
        except OSError:
            continue
else:
    rows = []
    result = subprocess.run(['ps', '-U', str(os.getuid()), '-o', 'pid=,command='], capture_output=True, text=True)
    for line in result.stdout.splitlines():
        try:
            pid, command = line.strip().split(None, 1)
            rows.append((pid, shlex.split(command)))
        except ValueError:
            continue
for pid, args in rows:
    if not args or Path(args[0]).name != 'ssh':
        continue
    if any(arg == '-N' or arg.startswith('-W') for arg in args[1:]):
        continue  # Tunnel-only clients and ProxyJump transports are not attached devboxes.
    index = 1
    while index < len(args) and args[index].startswith('-'):
        option = args[index]
        index += 1
        if option == '--':
            break
        if len(option) == 2 and option[1] in 'BbcDEeFIiJLlmOopQRSWw':
            index += 1
    if index >= len(args):
        continue
    host = args[index]
    command = ' '.join(args[index + 1:])
    if not re.fullmatch(r'[A-Za-z0-9_][A-Za-z0-9_.@:-]*', host):
        continue
    if 'theme-sync' in command:
        continue  # Exclude this script's own transport from discovery.
    if command and 'tmux' not in command:
        continue
    targets.setdefault(host, []).append(pid)
for sock in (Path.home() / '.ssh').glob('tmux-*.sock'):
    if sock.is_socket():
        host = sock.name[5:-5]
        if re.fullmatch(r'[A-Za-z0-9_][A-Za-z0-9_.@:-]*', host):
            targets.setdefault(host, []).append('socket-' + str(sock.stat().st_mtime_ns))
for host, identities in sorted(targets.items()):
    print(host, ','.join(sorted(identities)))
PYCODE
) || exit 0

state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/appearance-remotes
mkdir -p "$state_dir" || exit 0
n=0
while read -r alias connection; do
   [ -n "$alias" ] || continue
   stamp=$state_dir/$alias
   signature="$want $connection"
   [ "$(cat "$stamp" 2>/dev/null || :)" != "$signature" ] || continue
   n=$((n + 1))
   (
      sock=$HOME/.ssh/tmux-$alias.sock
      if [ -S "$sock" ] && deadline 6 tmux -S "$sock" run-shell -b "$remote_cmd" >/dev/null 2>&1; then
         applied=yes
      elif deadline 8 ssh -o ClearAllForwardings=yes -o BatchMode=yes -o ConnectTimeout=5 "$alias" "$remote_cmd" >/dev/null 2>&1; then
         applied=yes
      else
         applied=no
      fi
      # Do not cache failures: the next check retries. A new connection identity
      # forces initial sync even when the system mode has stayed unchanged.
      if [ "$applied" = yes ]; then
         printf '%s\n' "$signature" > "$stamp.$$" && mv "$stamp.$$" "$stamp"
      fi
   ) &
done <<EOF
$records
EOF
wait
[ "$n" -gt 0 ] && echo "theme-push-remotes: $want -> $n devbox(es) attempted" >&2
exit 0
