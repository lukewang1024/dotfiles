#!/bin/sh
# Move the dotfiles checkout to the XDG config root, atomically retarget managed
# symlinks, then remove the temporary ~/.dotfiles compatibility link.

set -u

script_dir=$(CDPATH='' cd -P -- "$(dirname -- "$0")" && pwd)
source_dir=$(CDPATH='' cd -P -- "$script_dir/../.." && pwd)
config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
target_dir=$config_home/dotfiles
legacy_path=$HOME/.dotfiles

case $config_home in
  /*) ;;
  *) printf 'XDG_CONFIG_HOME must be an absolute path: %s\n' "$config_home" >&2; exit 1 ;;
esac

physical_dir() {
  CDPATH='' cd -P -- "$1" 2>/dev/null && pwd
}

list_legacy_links() {
  for scan_root in \
    "$HOME/.config" \
    "$HOME/.local/bin" \
    "$HOME/.codex" \
    "$HOME/.claude" \
    "$HOME/.ssh" \
    "$HOME/Library/LaunchAgents" \
    "$HOME/Library/Rime"
  do
    [ -e "$scan_root" ] || [ -L "$scan_root" ] || continue
    find "$scan_root" -xdev -type l -print 2>/dev/null
  done
  find "$HOME" -xdev -maxdepth 1 -type l -print 2>/dev/null
}

legacy_links() {
  list_legacy_links |
    while IFS= read -r link_path; do
      link_target=$(readlink "$link_path" 2>/dev/null || true)
      case $link_target in
        "$legacy_path"|"$legacy_path"/*) printf '%s\n' "$link_path" ;;
      esac
    done
}

replace_link_atomically() {
  replacement=$1
  destination=$2
  case $(uname -s) in
    Darwin) mv -fh "$replacement" "$destination" ;;
    Linux) mv -fT "$replacement" "$destination" ;;
    *)
      printf 'Unsupported platform for atomic symlink replacement: %s\n' "$(uname -s)" >&2
      return 1
      ;;
  esac
}

finalize_links() {
  links=$(legacy_links)
  if [ -n "$links" ]; then
    printf '%s\n' "$links" |
      while IFS= read -r link_path; do
        old_target=$(readlink "$link_path") || exit 1
        suffix=${old_target#"$legacy_path"}
        new_target=$target_dir$suffix
        if [ "$dry_run" = true ]; then
          printf 'Would retarget %s -> %s\n' "$link_path" "$new_target"
          continue
        fi
        temporary_link=$link_path.dotfiles-migrate.$$
        if ! ln -s "$new_target" "$temporary_link" || ! replace_link_atomically "$temporary_link" "$link_path"; then
          printf 'Failed to retarget %s; keeping compatibility link.\n' "$link_path" >&2
          exit 1
        fi
        printf 'Retargeted %s -> %s\n' "$link_path" "$new_target"
      done || return 1
  fi

  if [ "$dry_run" = true ]; then
    [ -L "$legacy_path" ] && printf 'Would remove compatibility link %s\n' "$legacy_path"
    return 0
  fi

  remaining=$(legacy_links)
  if [ -n "$remaining" ]; then
    printf 'Legacy symlink targets remain; keeping %s:\n%s\n' "$legacy_path" "$remaining" >&2
    return 1
  fi

  if [ -L "$legacy_path" ]; then
    rm -f "$legacy_path"
    printf 'Removed compatibility link %s\n' "$legacy_path"
  fi
}

usage() {
  printf '%s\n' "Usage: $(basename "$0") [--dry-run]"
}

dry_run=false
case ${1:-} in
  '') ;;
  --dry-run) dry_run=true ;;
  -h|--help) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac
[ "$#" -le 1 ] || { usage >&2; exit 2; }

target_physical=$(physical_dir "$target_dir" || true)
if [ -n "$target_physical" ] && [ "$source_dir" = "$target_physical" ]; then
  if [ -L "$legacy_path" ] && [ "$(physical_dir "$legacy_path")" != "$target_physical" ]; then
    printf 'Refusing to remove unrelated legacy symlink: %s\n' "$legacy_path" >&2
    exit 1
  fi
  if [ -e "$legacy_path" ] && [ ! -L "$legacy_path" ]; then
    printf 'Refusing to replace existing legacy path: %s\n' "$legacy_path" >&2
    exit 1
  fi
  finalize_links || exit 1
  printf 'Migration complete: %s\n' "$target_dir"
  exit 0
fi

if [ -e "$target_dir" ] || [ -L "$target_dir" ]; then
  printf 'Refusing to overwrite migration target: %s\n' "$target_dir" >&2
  exit 1
fi

if [ -L "$legacy_path" ]; then
  printf 'Refusing to move a legacy path that is already a symlink: %s\n' "$legacy_path" >&2
  exit 1
fi

if [ "$source_dir" != "$(physical_dir "$legacy_path")" ]; then
  printf 'Refusing to move an unexpected checkout: %s\n' "$source_dir" >&2
  printf 'Expected the checkout at: %s\n' "$legacy_path" >&2
  exit 1
fi

if [ "$dry_run" = true ]; then
  printf 'Would move %s -> %s\n' "$source_dir" "$target_dir"
  finalize_links || exit 1
  exit 0
fi

mkdir -p "$config_home"
mv "$source_dir" "$target_dir"
if ! ln -s "$target_dir" "$legacy_path"; then
  printf 'Failed to create compatibility link; rolling the checkout back.\n' >&2
  if mv "$target_dir" "$source_dir"; then
    printf 'Rolled back to %s\n' "$source_dir" >&2
  else
    printf 'Rollback failed; checkout remains at %s\n' "$target_dir" >&2
  fi
  exit 1
fi

printf 'Migrated dotfiles to %s\n' "$target_dir"
printf 'Temporary compatibility link: %s -> %s\n' "$legacy_path" "$target_dir"
finalize_links || exit 1
printf 'Migration complete: %s\n' "$target_dir"
