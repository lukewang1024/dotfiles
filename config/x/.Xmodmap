! syntax:ssExcla

! remove capslock functionality
clear lock

! use capslock as hyper key
keycode 66 = Hyper_L Hyper_L Caps_Lock

! F18 as hyper key (for NoMachine passthrough from macOS)
! Use Hyper_R to avoid xcape Hyper_L=Escape triggering on repeats
keycode 196 = Hyper_R

! Escape is a normal key. Hyper owns navigation and mouse shortcuts now.
keycode 9 = Escape

! leave mod4 as super key only
remove mod4 = Hyper_L

! set mod3 to hyper key
add mod3 = Hyper_L Hyper_R

! Clear the retired Escape/Mode_switch layer on reload as well as fresh login.
! Duplicate navigation keysyms on letter keys make XKeysymToKeycode resolve
! arrows to H/J/K/L, breaking both xbindkeys grabs and xdotool key injection.
keycode 13 = 4 dollar 4 dollar
keycode 19 = 0 parenright 0 parenright
keycode 29 = y Y y Y
keycode 30 = u U u U
keycode 31 = i I i I
keycode 32 = o O o O
keycode 43 = h H h H
keycode 44 = j J j J
keycode 45 = k K k K
keycode 46 = l L l L
keycode 58 = m M m M
keycode 59 = comma less comma less
keycode 60 = period greater period greater
