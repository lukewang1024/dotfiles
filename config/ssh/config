# syntax:sshConfig

Host *
  AddKeysToAgent yes
  IgnoreUnknown UseKeychain
  UseKeychain yes

# Machine-specific hosts live in ~/.ssh/config.local (untracked; bootstrap
# touches an empty one). peon-ping remote-pane focus: give each devbox a
# LocalForward of its tmux control socket, so clicking a relayed notification
# switches the remote pane by driving the local tmux client over that socket
# (one round-trip, no extra ssh per click). ssh-focus.sh finds it via `ssh -G`.
# Add to the relevant Host block(s) in config.local:
#   Host <box>
#     LocalForward /Users/<you>/.ssh/tmux-%n.sock /tmp/tmux-<remote-uid>/default
#     StreamLocalBindUnlink yes   # clean stale sockets on reconnect
# (%n = the host alias, keeping the local socket per-box; requires local &
#  remote tmux to share a protocol version, else it falls back to ssh-exec.)
Include config.local

Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes

# Multiple account support

Host github.com-geek
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519-geek
  IdentitiesOnly yes

Host github.com-work
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519-work
  IdentitiesOnly yes

Host github.com-misc
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519-misc
  IdentitiesOnly yes

Host *
  Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com,aes256-ctr,aes192-ctr,aes128-ctr
  HostKeyAlgorithms ssh-ed25519-cert-v01@openssh.com,ssh-rsa-cert-v01@openssh.com,ssh-ed25519,ssh-rsa
  KexAlgorithms curve25519-sha256@libssh.org,diffie-hellman-group-exchange-sha256
  MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com,umac-128-etm@openssh.com,hmac-sha2-512,hmac-sha2-256,umac-128@openssh.com
  UseRoaming no
